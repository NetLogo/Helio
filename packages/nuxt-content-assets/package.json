{
  "name": "@repo/nuxt-content-assets",
  "version": "1.5.0",
  "description": "Enable locally-located assets in Nuxt Content",
  "repository": "davestewart/nuxt-content-assets",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "cache",
    "dist"
  ],
  "scripts": {
    "build": "nuxi prepare playground && nuxt-module-build build",
    "lint": "eslint .",
    "turbo:postinstall": "cd ./playground && nuxt prepare"
  },
  "dependencies": {
    "@nuxt/kit": "4.6.2",
    "crosspath": "^2.0.0",
    "debounce": "^1.2.1",
    "image-size": "^2.0.4",
    "listhen": "^1.9.0",
    "ohash": "^1.0.0",
    "unstorage": "^1.4.1",
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "@nuxt/content": "^3.16.2"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.3",
    "@nuxt/eslint-config": "^0.2.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "4.6.2",
    "@nuxt/test-utils": "^4.3.4",
    "@repo/eslint-config": "0.0.0",
    "@types/debounce": "^1.2.1",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.10",
    "cpy-cli": "^5.0.0",
    "eslint": "^9.31.0",
    "nuxt": "4.6.2",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
