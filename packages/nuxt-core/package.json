{
  "name": "@repo/nuxt-core",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./nuxt.config.ts": "./nuxt.config.ts",
    "./nuxt/tsconfig.json": "./.nuxt/tsconfig.json",
    "./runtime.config.schema": "./runtime.config.schema.ts",
    "./markdown.config": "./markdown.config.ts",
    "./content.config": "./content.config.ts",
    "./app/**/*": [
      "./app/**/*.ts",
      "./app/**/*.vue"
    ]
  },
  "scripts": {
    "create:env": "node -e \"const fs = require('fs'); if (fs.existsSync('.env.example')) { if (!fs.existsSync('.env')) { fs.copyFileSync('.env.example', '.env'); console.log('✓ .env created from .env.example'); } else { console.log('✓ .env already exists'); } } else { console.log('⚠ .env.example not found'); }\"",
    "init": "yarn run create:env && nuxt prepare",
    "turbo:postinstall": "nuxt prepare",
    "lint": "eslint . --max-warnings 0",
    "check-types": "nuxi typecheck"
  },
  "dependencies": {
    "nuxt": "4.6.2",
    "nuxt-gtag": "4.1.0",
    "nuxt-link-checker": "6.0.1",
    "nuxt-og-image": "^7.0.7",
    "satori": "^0.47.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tiptap/y-tiptap": "^3.0.10",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "nuxt-svgo": "4.2.6",
    "reka-ui": "2.11.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "3.5.44",
    "vue-router": "^5.4.0",
    "@nuxt/content": "^3.7.1",
    "@nuxt/eslint": "1.10.0",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/icon": "2.5.1",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/google-fonts": "3.2.0",
    "@nuxtjs/sitemap": "9.1.0",
    "@repo/common-data": "1.0.0",
    "@repo/eslint-config": "0.0.0",
    "@repo/markdown": "0.0.0",
    "@repo/netlogo-docs": "0.0.0",
    "@repo/tailwind-config": "0.0.0",
    "@repo/template": "0.0.0",
    "@repo/typescript-config": "0.0.0",
    "@repo/utils": "0.0.0",
    "@repo/vue-ui": "1.0.0"
  },
  "devDependencies": {
    "@nuxt/kit": "4.6.2",
    "@repo/nuxt-content-assets": "1.5.0",
    "turbo-meta-utilities": "^1.0.1",
    "typescript": "^5.4.0",
    "zod": "^4.1.12",
    "sass": "^1.93.3",
    "eslint": "^9.31.0"
  }
}