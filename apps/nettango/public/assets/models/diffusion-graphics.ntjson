{"spaces":[{"id":0,"spaceId":"ntb-defs-0","name":"Heat diffuser","width":500,"height":700,"defs":{"version":7,"height":700,"width":500,"blocks":[{"id":0,"action":"setup","isRequired":true,"placement":"starter","type":null,"format":"to setup-nettango","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":1,"note":null,"blockColor":"#000000","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[]},{"id":1,"action":"setup the model","isRequired":false,"placement":"child","type":null,"format":"\n  create-turtles {P0}   ; each turtle is like a heat source\n  [ setxy random-xcor random-ycor     ; position the turtles randomly\n    hide-turtle   ; so we don't see the turtles themselves, just the heat they produce\n     ] ; turtles set the patch variable\n","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":"this block sets up the whole model, wow! pick how many urtles to create","blockColor":null,"textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[{"name":"create","unit":" circles","step":1,"random":false,"default":30,"type":"int","def":30,"value":30}]},{"id":7,"action":"Set brightness","isRequired":false,"placement":"child","type":null,"format":"set brightness {0}","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":null,"textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[{"name":"Parameter 0","unit":null,"step":1,"random":false,"default":100,"type":"int","value":100}],"properties":[]},{"id":8,"action":"Set saturation","isRequired":false,"placement":"child","type":null,"format":"set saturation {0}","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":null,"textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[{"name":"Parameter 0","unit":null,"step":1,"random":false,"default":100,"type":"int","value":100}],"properties":[]},{"id":9,"action":"Set initial background color","isRequired":false,"placement":"child","type":null,"format":"set initial-color {P0}","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":"240 is blue, 120 green, 60 yellow, 0 red","blockColor":null,"textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[{"name":"Color of Background","unit":null,"type":"select","default":"240","quoteValues":"smart-quote","values":[{"actual":"240","display":"Blue"},{"actual":"120","display":"Green"},{"actual":"60","display":"Yellow"},{"actual":"0","display":"Red"}],"value":"240"}]},{"id":10,"action":"Set Position","isRequired":false,"placement":"child","type":null,"format":"ask turtles [setxy {P0} {P1}]","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":null,"textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[{"name":"x cor","unit":null,"step":1,"random":false,"default":0,"type":"int","value":0},{"name":"y cor","unit":null,"step":1,"random":false,"default":0,"type":"int","value":0}]},{"id":11,"action":"Set some circles' position","isRequired":false,"placement":"child","type":null,"format":"ask n-of {P0} turtles [setxy {P1} {P2}]","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":null,"textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[{"name":"How many circles to ask","unit":null,"step":1,"random":false,"default":1,"type":"int","value":1},{"name":"x cor","unit":null,"step":1,"random":false,"default":0,"type":"int","value":0},{"name":"y cor","unit":null,"step":1,"random":false,"default":0,"type":"int","value":0}]},{"id":2,"action":"go","isRequired":true,"placement":"starter","type":null,"format":"to go-nettango","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":1,"note":null,"blockColor":null,"textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[]},{"id":3,"action":"set patch-here heat","isRequired":false,"placement":"child","type":null,"format":"ask turtles [ set heat {0} ] ","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":null,"textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[{"name":"heat","unit":" cal","step":1,"random":false,"default":500,"type":"int","value":500}],"properties":[]},{"id":5,"action":"diffuse heat","isRequired":false,"placement":"child","type":null,"format":"diffuse heat {0} / 100","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":null,"textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[{"name":"diffuse rate","unit":"%","step":1,"random":false,"default":50,"type":"range","min":0,"max":100,"def":50,"value":50}],"properties":[]},{"id":4,"action":"set speed of circles","isRequired":false,"placement":"child","type":null,"format":"ask turtles [fd {0}]","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":null,"textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[{"name":"speed","unit":" M/s","type":"num","default":"1.0","value":"1.0"}],"properties":[]},{"id":6,"action":"wander","isRequired":false,"placement":"child","type":null,"format":"ask turtles \n[ \n  rt random {P0} \n  lt random {P1}\n] ","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":null,"textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[{"name":"right bias","unit":null,"step":1,"random":false,"default":50,"type":"int","value":50},{"name":"left bias","unit":null,"step":1,"random":false,"default":50,"type":"int","value":50}]}],"menuConfig":{"mainGroup":{"isCollapsed":false,"order":[0,1,7,8,9,10,11,2,3,5,4,6]},"tagGroups":[]},"program":{"chains":[{"x":4,"y":38,"blocks":[{"definitionId":0,"instanceId":0,"clauses":[],"params":[],"properties":[],"propertiesDisplay":"shown"},{"definitionId":1,"instanceId":0,"clauses":[],"params":[],"properties":[{"type":"int","value":10}],"propertiesDisplay":"shown"},{"definitionId":7,"instanceId":0,"clauses":[],"params":[{"type":"int","value":95}],"properties":[],"propertiesDisplay":"shown"},{"definitionId":8,"instanceId":0,"clauses":[],"params":[{"type":"int","value":70}],"properties":[],"propertiesDisplay":"shown"},{"definitionId":9,"instanceId":0,"clauses":[],"params":[],"properties":[{"type":"select","value":"240"}],"propertiesDisplay":"shown"}]},{"x":37,"y":321,"blocks":[{"definitionId":2,"instanceId":0,"clauses":[],"params":[],"properties":[],"propertiesDisplay":"shown"}]}]},"chainOpen":null,"chainClose":"end","variables":[],"expressions":[{"name":"true","type":"bool","arguments":[],"format":null},{"name":"false","type":"bool","arguments":[],"format":null},{"name":"AND","type":"bool","arguments":["bool","bool"],"format":"({0} and {1})"},{"name":"OR","type":"bool","arguments":["bool","bool"],"format":"({0} or {1})"},{"name":"NOT","type":"bool","arguments":["bool"],"format":"(not {0})"},{"name":">","type":"bool","arguments":["num","num"],"format":null},{"name":">=","type":"bool","arguments":["num","num"],"format":null},{"name":"<","type":"bool","arguments":["num","num"],"format":null},{"name":"<=","type":"bool","arguments":["num","num"],"format":null},{"name":"!=","type":"bool","arguments":["num","num"],"format":null},{"name":"=","type":"bool","arguments":["num","num"],"format":null},{"name":"+","type":"num","arguments":["num","num"],"format":null},{"name":"-","type":"num","arguments":["num","num"],"format":null},{"name":"×","type":"num","arguments":["num","num"],"format":"({0} * {1})"},{"name":"/","type":"num","arguments":["num","num"],"format":null},{"name":"random","type":"num","arguments":["num"],"format":"random-float {0}"}]},"netLogoCode":"to go-nettango\nend\n\nto setup-nettango\n  \n    create-turtles 10   ; each turtle is like a heat source\n    [ setxy random-xcor random-ycor     ; position the turtles randomly\n      hide-turtle   ; so we don't see the turtles themselves, just the heat they produce\n       ] ; turtles set the patch variable\n  \n  set brightness 95\n  set saturation 70\n  set initial-color 240\nend","netLogoDisplay":"to go-nettango\nend\n\nto setup-nettango\n  \n    create-turtles 10   ; each turtle is like a heat source\n    [ setxy random-xcor random-ycor     ; position the turtles randomly\n      hide-turtle   ; so we don't see the turtles themselves, just the heat they produce\n       ] ; turtles set the patch variable\n  \n  set brightness 95\n  set saturation 70\n  set initial-color 240\nend"}],"netTangoOptions":{"workspaceBelow":false,"showCode":false,"enablePlayModeDefinitionChanges":false,"enableCodeTips":true},"netLogoOptions":{"commandCenterTab":true,"codeTab":false,"infoTab":false,"inspectionTab":true,"speedBar":false,"fileButtons":false,"authoring":false,"poweredBy":true},"blockStyles":{"starterBlockStyle":{"blockColor":"#000000","textColor":"#ffffff","borderColor":"#000000","fontWeight":"","fontSize":"","fontFace":""},"containerBlockStyle":{"blockColor":"#8899aa","textColor":"#ffffff","borderColor":"#ffffff","fontWeight":"","fontSize":"","fontFace":""},"commandBlockStyle":{"blockColor":"#ffffff","textColor":"#000000","borderColor":"#f2f2f2","fontWeight":"","fontSize":"","fontFace":""}},"title":"Diffusion Graphics Nettango 3","extraCss":"","code":"<?xml version=\"1.0\" encoding=\"utf-8\"?><model version=\"NetLogo 7.0.4\" snapToGrid=\"false\" nlw-version=\"2.16.0\">\n  <code>patches-own [ heat ]\n\nglobals [turtle-heat turtle-speed DIFFUSION-RATE saturation brightness initial-color]\n\nto setup\n  clear-all\n  set-default-shape turtles \"circle\"\n setup-nettango\n  ask turtles [show-turtle]\n  recolor-patches                       ; color patches according to heat\n  reset-ticks\nend\n\nto go\n  go-nettango\n  recolor-patches                        ; color patches according to heat\n  tick\nend\n\n\nto recolor-patches  ;; color patches according to heat\n  ask patches [ set pcolor hsb ((initial-color - heat) mod 360) saturation brightness ]\nend\n\nto draw\n\n      \n        if mouse-down?\n        [\n          \n            ask patch mouse-xcor mouse-ycor\n            [\n              sprout 1 [ set shape \"circle\"]\n            ]\n          \n        ]\n  \n      \n  end\n\n; Copyright 2021 Kit Martin.\n\n; --- NETTANGO BEGIN ---\n\n; This block of code was added by the NetTango Web Builder.  If you modify this code\n; and re-import it into the NetTango Web Builder you may lose your changes or need\n; to resolve some errors manually.\n\n; If you do not plan to re-import the model into the NetTango Web Builder then you\n; can safely edit this code however you want, just like a normal NetLogo model.\n\nto go-nettango\nend\n\nto setup-nettango\n  \n    create-turtles 10   ; each turtle is like a heat source\n    [ setxy random-xcor random-ycor     ; position the turtles randomly\n      hide-turtle   ; so we don't see the turtles themselves, just the heat they produce\n       ] ; turtles set the patch variable\n  \n  set brightness 95\n  set saturation 70\n  set initial-color 240\nend\n; --- NETTANGO END ---</code>\n  <widgets>\n    <view x=\"110\" wrappingAllowedX=\"true\" y=\"10\" frameRate=\"30\" minPycor=\"-50\" height=\"312\" showTickCounter=\"true\" patchSize=\"3\" fontSize=\"10\" wrappingAllowedY=\"true\" width=\"761\" tickCounterLabel=\"ticks\" maxPycor=\"50\" updateMode=\"1\" maxPxcor=\"125\" minPxcor=\"-125\"/>\n    <button x=\"5\" y=\"10\" height=\"40\" disableUntilTicks=\"false\" forever=\"false\" kind=\"Observer\" width=\"95\" display=\"setup\">setup</button>\n    <button x=\"5\" y=\"55\" height=\"40\" disableUntilTicks=\"true\" forever=\"true\" kind=\"Observer\" width=\"95\" display=\"go\">draw go </button>\n  </widgets>\n  <info><![CDATA[## WHAT IS IT?\n\nDiffusion Graphics is unlike most other NetLogo models, in that it really doesn't 'model' anything. It simply explores the power behind an interesting patch primitive: 'diffuse'.\n\nIt's not intended to closely model real heat, just a number that behaves something like heat -- that slowly spreads itself evenly across a plane.\n\n## HOW IT WORKS\n\nIn this model, the turtles are \"hot spots\" -- they set a certain value (a patch variable called 'heat') to the maximum level every time step. Each patch (through the 'diffuse' primitive) then shares its value of 'heat' with its surrounding patches.\n\nHere you can watch what happens as hot-spots interact with each other, as they move around, as their values become negative, or as the 'heat' slowly decays down to nothing. The whole point of the project is to give you an idea how patches interact via the 'diffuse' primitive. (Or maybe just to give you something nice to stare at if you're bored.)\n\n## HOW TO USE IT\n\nTwo buttons, SETUP and GO, control execution of the model. As in most NetLogo models, the SETUP button will initialize the 'hot-spots' and other variables, preparing the model to be run. The GO button, a forever button, will then run the model.\n\nTo initialize the model with NetTango, drag out the blocks setup. Attach the following 4 blocks to it: setup the model, Set brightness, Set Saturation, and Set initial background color. For now keep the default values for all of the blocks, you can tinker with them later to form an intuition of how they affect the model.\n\nNext drag out the go block. Attach the following 4 blocks to it: wander, set speed of circles, diffuse heat, set patch-here heat. You can leave the initial values for each of these. \n\nwander, If you don't include this block the turtles will stay rooted in place.\n\nset speed of circles, if you increase this number, the turtles will start hopping across the screen at a higher rate.\n\ndiffuse heat, this is the basis of the model. If the value is set to 100% this means Tell each patch to give equal shares of 100% percent of the value (heat) of patch-variable to its eight neighboring patches. the value is between 0 and 1. Regardless of topology the sum of heat will be conserved across the world. This spreads the heat out, after the circles deposit it.\n\n\nset patch-here heat, ask each circle to add the value set to the patch its on heat. Increase this value will make the model 'heat up' faster.\n\n## THINGS TO NOTICE\n\nMainly what Diffusion Graphics will show you is how patch-color is diffused in NetTango.  The graphical display may evoke fractal imagery, or a topographical landscape.  Diffusion Graphics really does bring about a topography of sorts, with the turtles being peaks, and the darkest colors being valleys. The model essentially tries to then smooth out these differences.\n\nLet the model run for a while without the wander block. Watch what happens to the 'terrain'. What do you predict will eventually happen?\n\nThis model was built to please. Just play around with the blocks to alter the code and see what works (and what doesn't work, too).\n\n## THINGS TO TRY\n\nTry setting set patch-here heat to a very large number.  What happens?  What does this show you about the RGB color scale?\n\n\n## EXTENDING THE MODEL\n\nChange it so that the setup the model, creat 30 circles  would change the number of turtles on the fly, instead of requiring you to hit SETUP.\n\nCurrently the position of each turtle is determined randomly at setup. Change the model so that the user may position turtles with the mouse.\n\n\n## NETLOGO FEATURES\n\nThe Diffusion Graphics model was designed around the `diffuse` primitive.   `diffuse` is an observer primitive that takes two inputs, a patch variable and a number.  `diffuse` makes all the patches share that patch variable with their eight neighbors.  The second input is a number between 0 and 1.0 determines what fraction of the patch variable is shared.  (In this model, the amount shared is controlled by diffuse heat block.)  So for example, if I ask the observer to `diffuse heat 50%`, the observer tells each patch to give half of `heat` to the eight other patches.  If a patch had 80 to begin with, then it keeps 40 and gives 5 away to each neighbor.  The total value of `heat` for all the patches remains constant.\n\n## RELATED MODELS\n\nDiffusion (models real heat more closely)\n\n## HOW TO CITE\n\nIf you mention this model or the NetLogo software in a publication, we ask that you include the citations below.\n\nFor the model itself:\n\n* Martin, Kit.  NetTango RGB Diffusion Graphics model.   Center for Connected Learning and Computer-Based Modeling, Northwestern University, Evanston, IL.\n\nPlease cite the NetLogo software as:\n\n* Wilensky, U. (1999). NetLogo. http://ccl.northwestern.edu/netlogo/. Center for Connected Learning and Computer-Based Modeling, Northwestern University, Evanston, IL.\n\n## COPYRIGHT AND LICENSE\n\nCopyright 1997 Uri Wilensky.\n\n![CC BY-NC-SA 3.0](http://ccl.northwestern.edu/images/creativecommons/byncsa.png)\n\nThis work is licensed under the Creative Commons Attribution-NonCommercial-ShareAlike 3.0 License.  To view a copy of this license, visit https://creativecommons.org/licenses/by-nc-sa/3.0/ or send a letter to Creative Commons, 559 Nathan Abbott Way, Stanford, California 94305, USA.\n\nCommercial licenses are also available. To inquire about commercial licenses, please contact Uri Wilensky at uri@northwestern.edu.\n\nThis model was created as part of the project: Theory Building:  The project gratefully acknowledges the support of the National Science Foundation (National Science Foundation (NSF Stem+C: Award # 1842375) for supporting this work.\n\n\n\n<!-- 2021 -->]]></info>\n  <turtleShapes>\n    <shape name=\"default\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"5\"/>\n        <point x=\"40\" y=\"250\"/>\n        <point x=\"150\" y=\"205\"/>\n        <point x=\"260\" y=\"250\"/>\n      </polygon>\n    </shape>\n    <shape name=\"airplane\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"0\"/>\n        <point x=\"135\" y=\"15\"/>\n        <point x=\"120\" y=\"60\"/>\n        <point x=\"120\" y=\"105\"/>\n        <point x=\"15\" y=\"165\"/>\n        <point x=\"15\" y=\"195\"/>\n        <point x=\"120\" y=\"180\"/>\n        <point x=\"135\" y=\"240\"/>\n        <point x=\"105\" y=\"270\"/>\n        <point x=\"120\" y=\"285\"/>\n        <point x=\"150\" y=\"270\"/>\n        <point x=\"180\" y=\"285\"/>\n        <point x=\"210\" y=\"270\"/>\n        <point x=\"165\" y=\"240\"/>\n        <point x=\"180\" y=\"180\"/>\n        <point x=\"285\" y=\"195\"/>\n        <point x=\"285\" y=\"165\"/>\n        <point x=\"180\" y=\"105\"/>\n        <point x=\"180\" y=\"60\"/>\n        <point x=\"165\" y=\"15\"/>\n      </polygon>\n    </shape>\n    <shape name=\"arrow\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"0\"/>\n        <point x=\"0\" y=\"150\"/>\n        <point x=\"105\" y=\"150\"/>\n        <point x=\"105\" y=\"293\"/>\n        <point x=\"195\" y=\"293\"/>\n        <point x=\"195\" y=\"150\"/>\n        <point x=\"300\" y=\"150\"/>\n      </polygon>\n    </shape>\n    <shape name=\"box\" rotatable=\"false\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"285\"/>\n        <point x=\"285\" y=\"225\"/>\n        <point x=\"285\" y=\"75\"/>\n        <point x=\"150\" y=\"135\"/>\n      </polygon>\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"135\"/>\n        <point x=\"15\" y=\"75\"/>\n        <point x=\"150\" y=\"15\"/>\n        <point x=\"285\" y=\"75\"/>\n      </polygon>\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"15\" y=\"75\"/>\n        <point x=\"15\" y=\"225\"/>\n        <point x=\"150\" y=\"285\"/>\n        <point x=\"150\" y=\"135\"/>\n      </polygon>\n      <line endX=\"150\" startY=\"285\" marked=\"false\" color=\"255\" endY=\"135\" startX=\"150\"/>\n      <line endX=\"15\" startY=\"135\" marked=\"false\" color=\"255\" endY=\"75\" startX=\"150\"/>\n      <line endX=\"285\" startY=\"135\" marked=\"false\" color=\"255\" endY=\"75\" startX=\"150\"/>\n    </shape>\n    <shape name=\"bug\" rotatable=\"true\" editableColorIndex=\"0\">\n      <circle x=\"96\" y=\"182\" marked=\"true\" color=\"-1920102913\" diameter=\"108\" filled=\"true\"/>\n      <circle x=\"110\" y=\"127\" marked=\"true\" color=\"-1920102913\" diameter=\"80\" filled=\"true\"/>\n      <circle x=\"110\" y=\"75\" marked=\"true\" color=\"-1920102913\" diameter=\"80\" filled=\"true\"/>\n      <line endX=\"80\" startY=\"100\" marked=\"true\" color=\"-1920102913\" endY=\"30\" startX=\"150\"/>\n      <line endX=\"220\" startY=\"100\" marked=\"true\" color=\"-1920102913\" endY=\"30\" startX=\"150\"/>\n    </shape>\n    <shape name=\"butterfly\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"165\"/>\n        <point x=\"209\" y=\"199\"/>\n        <point x=\"225\" y=\"225\"/>\n        <point x=\"225\" y=\"255\"/>\n        <point x=\"195\" y=\"270\"/>\n   