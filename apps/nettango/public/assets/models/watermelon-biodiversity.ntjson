{"spaces":[{"id":0,"spaceId":"ntb-defs-0","name":"Programming Watermelon Patch","width":600,"height":1200,"defs":{"version":7,"height":1200,"width":600,"blocks":[{"id":0,"action":"setup","isRequired":true,"placement":"starter","type":"nlogo:procedure","format":"to setup-NetTango\n  ; where you put code you want to happen at the beginng of the simulation","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":1,"note":null,"blockColor":"#98b1b3","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[],"control":false},{"id":1,"action":"go","isRequired":true,"placement":"starter","type":"nlogo:procedure","format":"to go-NetTango\n  ;the procedure that lets you instruct the watermelons\n  ;what to to every minute","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":1,"note":null,"blockColor":"#98b1b3","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[],"control":false},{"id":2,"action":"add sexual watermelons","isRequired":false,"placement":"child","type":null,"format":"\ncreate-seededs {0}\n  [\n    setxy [pxcor] of one-of patches with [pxcor < {P0} ] [pycor] of one-of patches with [pxcor < {P0} ]\n    if any? other turtles-here [ setxy random-xcor random-ycor]\n    set color red\n  ]","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#ad0505","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[{"name":"Parameter 0","unit":null,"type":"num","default":"8","value":"8"}],"properties":[{"name":"dividing line between watermelon types","unit":null,"type":"num","default":"1","value":"1"}]},{"id":3,"action":"add asexual watermelons","isRequired":false,"placement":"child","type":"nlogo:command","format":"create-unseededs {0}\n  [\n    setxy [pxcor] of one-of patches with [pxcor > {P0} ] [pycor] of one-of patches with [pxcor > {P0} ]\n    if any? other turtles-here\n    [\n      setxy random-xcor random-ycor\n    ]\n    set color green\n  ]","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#0dae0a","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[{"name":"Parameter 0","unit":null,"type":"num","default":"8","value":"8"}],"properties":[{"name":"dividing line between watermelon types","unit":null,"type":"num","default":"1","value":"1"}],"control":false},{"id":13,"action":"add fungi","isRequired":false,"placement":"child","type":"nlogo:command","format":"create-some-fungi-button  {0} {P0} {P1} {P2} \n;ask fungi [ setxy {P0} {P1} set prey-type {P2} set colortoinfect {P2} \nask fungi [if prey-type = 5 [set prey-type one-of [green green red red blue yellow magenta]\nset colortoinfect one-of [green green red red blue yellow magenta]]]","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#adadad","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[{"name":"number of fungi to ad","unit":null,"type":"num","default":"10","value":"10"}],"properties":[{"name":"starting x-cordinate","unit":"x","type":"num","default":"0","value":"0"},{"name":"starting y-cordinate","unit":"y","type":"num","default":"0","value":"0"},{"name":"Color of Watermelon","unit":null,"type":"select","default":"5","quoteValues":"smart-quote","values":[{"actual":"125","display":"Magenta"},{"actual":"105","display":"Blue"},{"actual":"15","display":"Red"},{"actual":"55","display":"Green"},{"actual":"45","display":"Yellow"},{"actual":"5","display":"Random"}],"value":"5"}],"control":false},{"id":4,"action":"ask sexuals","isRequired":false,"placement":"child","type":"nlogo:if","format":"ask seededs","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#ad0505","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[{"action":null,"open":"[","close":"]","allowedTags":{"type":"unrestricted"}}],"params":[],"properties":[],"control":true},{"id":5,"action":"ask asexuals","isRequired":false,"placement":"child","type":"nlogo:if","format":"ask unseededs","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#0dae0a","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[{"action":null,"open":"[","close":"]","allowedTags":{"type":"unrestricted"}}],"params":[],"properties":[],"control":true},{"id":6,"action":"ask fungi","isRequired":false,"placement":"child","type":"nlogo:if","format":"ask fungi","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#adadad","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[{"action":null,"open":"[","close":"]","allowedTags":{"type":"unrestricted"}}],"params":[],"properties":[],"control":true},{"id":7,"action":"reproduce asexuals","isRequired":false,"placement":"child","type":"nlogo:command","format":"; asks the asexual watermelons to reproduce 2% of the time, or whatever you set reproduction probability to.\n\n    if random 100 < {P0}\n    [\n      hatch 1\n      [\n        set xcor xcor - 2\n        set ycor ycor - random 4\n        set color green\n        if any? other turtles-here with [breed != fungi]\n        [\n          die\n        ]\n      ]\n    ]\n    \n","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#0dae0a","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[{"name":"reproduction-probability","unit":"%","type":"num","default":"2","value":"2"}],"control":false},{"id":8,"action":"reproduce sexuals","isRequired":false,"placement":"child","type":"nlogo:command","format":"; asks the sexual watermelons to reproduce 2% of the time, or whatever you set reproduction probability to.\n\n\n           if random 100 < {P0}\n        [\n          hatch 1\n          [\n            set xcor xcor - 1\n            set ycor ycor - random 3\n            \n            if random 100 < {P1} [set color one-of [ red blue yellow magenta ]]\n           \n            if any? other turtles-here with [breed != fungi]\n            [\n              die\n            ]\n          ]\n        ]\n    ","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#ad0505","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[{"name":"reproduction-probability","unit":"%","type":"num","default":"2","value":"2"},{"name":"probability watermelons mutate when they reproduce","unit":"%","type":"num","default":"22","value":"22"}],"control":false},{"id":9,"action":"chance","isRequired":false,"placement":"child","type":"nlogo:if","format":"if random 100 < {0}","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#adadad","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[{"action":null,"open":"[","close":"]","allowedTags":{"type":"unrestricted"}}],"params":[{"name":"percent","unit":"%","step":0.5,"random":false,"default":20,"type":"range","min":0,"max":100,"value":20}],"properties":[],"control":true},{"id":10,"action":"die","isRequired":false,"placement":"child","type":"nlogo:command","format":"die","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#adadad","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[],"control":false},{"id":11,"action":"move","isRequired":false,"placement":"child","type":"nlogo:command","format":"    if can-move? {P0}\n    [\n      rt random {P1}\n      lt random {P2}\n      fd {P0}\n    ]","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#adadad","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[{"name":"how far fungus spore floats","unit":null,"type":"num","default":".007","value":".007"},{"name":"drift right","unit":null,"type":"num","default":"3","value":"3"},{"name":"drift left","unit":null,"type":"num","default":"3","value":"3"}],"control":false},{"id":12,"action":"infect","isRequired":false,"placement":"child","type":"nlogo:command","format":"infect {P0} {P1}\nset probability-fungi-mutate {P2}","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#adadad","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[{"name":"How many spores to hatch","unit":null,"type":"num","default":"1","def":"1","value":"1"},{"name":"carrying capacity of total spores in the model","unit":null,"type":"num","default":"50","def":"50","value":"50"},{"name":"probability-when-new-infection-they-mutate","unit":null,"type":"num","default":"0","def":"0","value":"0"}],"control":false},{"id":14,"action":"to start an infect","isRequired":true,"placement":"starter","type":"nlogo:procedure","format":"to start-an-infection-NetTango","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":1,"note":null,"blockColor":null,"textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[],"control":false},{"id":15,"action":"mutate fungus","isRequired":false,"placement":"child","type":null,"format":"set probability-fungi-mutate {P0}\nif random 100 < probability-fungi-mutate \n[ set colortoinfect one-of [ red green blue yellow magenta ] ask fungi [set prey-type colortoinfect] ]","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#adadad","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[{"name":"Probability fungi mutate","unit":"%","step":1,"random":false,"default":10,"type":"range","min":0,"max":100,"value":10}]},{"id":16,"action":"Set time of infection","isRequired":false,"placement":"child","type":null,"format":"; if you want to start an infection at a particular time\nset ticktostartinfection ticks + {P0}\n","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#adadad","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[{"name":"Time the infection starts","unit":null,"type":"num","default":"100","value":"100"}]}],"menuConfig":{"mainGroup":{"isCollapsed":false,"order":[0,1,2,3,13,4,5,6,7,8,9,10,11,12,14,15,16]},"tagGroups":[]},"program":{"chains":[{"x":14,"y":64,"blocks":[{"definitionId":0,"instanceId":0,"clauses":[],"params":[],"properties":[],"propertiesDisplay":"shown"},{"definitionId":2,"instanceId":0,"clauses":[],"params":[{"type":"num","value":{"name":"8","type":"num","format":null,"children":[]},"expressionValue":"0"}],"properties":[{"type":"num","value":{"name":"0","type":"num","format":null,"children":[]},"expressionValue":"0"}],"propertiesDisplay":"shown"},{"definitionId":3,"instanceId":0,"clauses":[],"params":[{"type":"num","value":{"name":"8","type":"num","format":null,"children":[]},"expressionValue":"0"}],"properties":[{"type":"num","value":{"name":"0","type":"num","format":null,"children":[]},"expressionValue":"0"}],"propertiesDisplay":"shown"}]},{"x":17,"y":381,"blocks":[{"definitionId":1,"instanceId":0,"clauses":[],"params":[],"properties":[],"propertiesDisplay":"shown"},{"definitionId":4,"instanceId":0,"clauses":[{"blocks":[{"definitionId":8,"instanceId":0,"clauses":[],"params":[],"properties":[{"type":"num","value":{"name":"2","type":"num","format":null,"children":[]},"expressionValue":"0"},{"type":"num","value":{"name":"22","type":"num","format":null,"children":[]},"expressionValue":"0"}],"propertiesDisplay":"hidden"}]}],"params":[],"properties":[],"propertiesDisplay":"shown"},{"definitionId":5,"instanceId":0,"clauses":[{"blocks":[{"definitionId":7,"instanceId":0,"clauses":[],"params":[],"properties":[{"type":"num","value":{"name":"2","type":"num","format":null,"children":[]},"expressionValue":"0"}],"propertiesDisplay":"hidden"}]}],"params":[],"properties":[],"propertiesDisplay":"shown"},{"definitionId":6,"instanceId":0,"clauses":[{"blocks":[{"definitionId":11,"instanceId":0,"clauses":[],"params":[],"properties":[{"type":"num","value":{"name":".007","type":"num","format":null,"children":[]},"expressionValue":"0"},{"type":"num","value":{"name":"3","type":"num","format":null,"children":[]},"expressionValue":"0"},{"type":"num","value":{"name":"3","type":"num","format":null,"children":[]},"expressionValue":"0"}],"propertiesDisplay":"hidden"},{"definitionId":12,"instanceId":0,"clauses":[],"params":[],"properties":[{"type":"num","value":{"name":"1","type":"num","format":null,"children":[]},"expressionValue":"0"},{"type":"num","value":{"name":"50","type":"num","format":null,"children":[]},"expressionValue":"0"},{"type":"num","value":{"name":"0","type":"num","format":null,"children":[]},"expressionValue":"0"}],"propertiesDisplay":"hidden"}]}],"params":[],"properties":[],"propertiesDisplay":"shown"}]},{"x":20,"y":853,"blocks":[{"definitionId":14,"instanceId":0,"clauses":[],"params":[],"properties":[],"propertiesDisplay":"shown"},{"definitionId":13,"instanceId":0,"clauses":[],"params":[{"type":"num","value":{"name":"10","type":"num","format":null,"children":[]},"expressionValue":"0"}],"properties":[{"type":"num","value":{"name":"9","type":"num","format":null,"children":[]},"expressionValue":"0"},{"type":"num","value":{"name":"0","type":"num","format":null,"children":[]},"expressionValue":"0"},{"type":"select","value":"55"}],"propertiesDisplay":"shown"}]}]},"chainOpen":null,"chainClose":"end","variables":[],"expressions":[{"name":"true","type":"bool","arguments":[],"format":null},{"name":"false","type":"bool","arguments":[],"format":null},{"name":"AND","type":"bool","arguments":["bool","bool"],"format":"({0} and {1})"},{"name":"OR","type":"bool","arguments":["bool","bool"],"format":"({0} or {1})"},{"name":"NOT","type":"bool","arguments":["bool"],"format":"(not {0})"},{"name":">","type":"bool","arguments":["num","num"],"format":null},{"name":">=","type":"bool","arguments":["num","num"],"format":null},{"name":"<","type":"bool","arguments":["num","num"],"format":null},{"name":"<=","type":"bool","arguments":["num","num"],"format":null},{"name":"!=","type":"bool","arguments":["num","num"],"format":null},{"name":"=","type":"bool","arguments":["num","num"],"format":null},{"name":"+","type":"num","arguments":["num","num"],"format":null},{"name":"-","type":"num","arguments":["num","num"],"format":null},{"name":"×","type":"num","arguments":["num","num"],"format":"({0} * {1})"},{"name":"/","type":"num","arguments":["num","num"],"format":null},{"name":"random","type":"num","arguments":["num"],"format":"random-float {0}"}]},"netLogoCode":"to go-NetTango\n  ;the procedure that lets you instruct the watermelons\n  ;what to to every minute\n  ask seededs\n  [\n    ; asks the sexual watermelons to reproduce 2% of the time, or whatever you set reproduction probability to.\n    \n    \n               if random 100 < 2\n            [\n              hatch 1\n              [\n                set xcor xcor - 1\n                set ycor ycor - random 3\n                \n                if random 100 < 22 [set color one-of [ red blue yellow magenta ]]\n               \n                if any? other turtles-here with [breed != fungi]\n                [\n                  die\n                ]\n              ]\n            ]\n        \n  ]\n  ask unseededs\n  [\n    ; asks the asexual watermelons to reproduce 2% of the time, or whatever you set reproduction probability to.\n    \n        if random 100 < 2\n        [\n          hatch 1\n          [\n            set xcor xcor - 2\n            set ycor ycor - random 4\n            set color green\n            if any? other turtles-here with [breed != fungi]\n            [\n              die\n            ]\n          ]\n        ]\n        \n    \n  ]\n  ask fungi\n  [\n        if can-move? .007\n        [\n          rt random 3\n          lt random 3\n          fd .007\n        ]\n    infect 1 50\n    set probability-fungi-mutate 0\n  ]\nend\n\nto setup-NetTango\n  ; where you put code you want to happen at the beginng of the simulation\n  \n  create-seededs 8\n    [\n      setxy [pxcor] of one-of patches with [pxcor < 0 ] [pycor] of one-of patches with [pxcor < 0 ]\n      if any? other turtles-here [ setxy random-xcor random-ycor]\n      set color red\n    ]\n  create-unseededs 8\n    [\n      setxy [pxcor] of one-of patches with [pxcor > 0 ] [pycor] of one-of patches with [pxcor > 0 ]\n      if any? other turtles-here\n      [\n        setxy random-xcor random-ycor\n      ]\n      set color green\n    ]\nend\n\nto start-an-infection-NetTango\n  create-some-fungi-button  10 9 0 55 \n  ;ask fungi [ setxy 9 0 set prey-type 55 set colortoinfect 55 \n  ask fungi [if prey-type = 5 [set prey-type one-of [green green red red blue yellow magenta]\n  set colortoinfect one-of [green green red red blue yellow magenta]]]\nend","netLogoDisplay":"to go-NetTango\n  ;the procedure that lets you instruct the watermelons\n  ;what to to every minute\n  ask seededs\n  [\n    ; asks the sexual watermelons to reproduce 2% of the time, or whatever you set reproduction probability to.\n    \n    \n               if random 100 < 2\n            [\n              hatch 1\n              [\n                set xcor xcor - 1\n                set ycor ycor - random 3\n                \n                if random 100 < 22 [set color one-of [ red blue yellow magenta ]]\n               \n                if any? other turtles-here with [breed != fungi]\n                [\n                  die\n                ]\n              ]\n            ]\n        \n  ]\n  ask unseededs\n  [\n    ; asks the asexual watermelons to reproduce 2% of the time, or whatever you set reproduction probability to.\n    \n        if random 100 < 2\n        [\n          hatch 1\n          [\n            set xcor xcor - 2\n            set ycor ycor - random 4\n            set color green\n            if any? other turtles-here with [breed != fungi]\n            [\n              die\n            ]\n          ]\n        ]\n        \n    \n  ]\n  ask fungi\n  [\n        if can-move? .007\n        [\n          rt random 3\n          lt random 3\n          fd .007\n        ]\n    infect 1 50\n    set probability-fungi-mutate 0\n  ]\nend\n\nto setup-NetTango\n  ; where you put code you want to happen at the beginng of the simulation\n  \n  create-seededs 8\n    [\n      setxy [pxcor] of one-of patches with [pxcor < 0 ] [pycor] of one-of patches with [pxcor < 0 ]\n      if any? other turtles-here [ setxy random-xcor random-ycor]\n      set color red\n    ]\n  create-unseededs 8\n    [\n      setxy [pxcor] of one-of patches with [pxcor > 0 ] [pycor] of one-of patches with [pxcor > 0 ]\n      if any? other turtles-here\n      [\n        setxy random-xcor random-ycor\n      ]\n      set color green\n    ]\nend\n\nto start-an-infection-NetTango\n  create-some-fungi-button  10 9 0 55 \n  ;ask fungi [ setxy 9 0 set prey-type 55 set colortoinfect 55 \n  ask fungi [if prey-type = 5 [set prey-type one-of [green green red red blue yellow magenta]\n  set colortoinfect one-of [green green red red blue yellow magenta]]]\nend"}],"netTangoOptions":{"workspaceBelow":true,"showCode":false,"enablePlayModeDefinitionChanges":false,"enableCodeTips":true},"netLogoOptions":{"commandCenterTab":true,"codeTab":true,"infoTab":true,"inspectionTab":true,"speedBar":false,"fileButtons":true,"authoring":true,"poweredBy":true},"blockStyles":{"starterBlockStyle":{"blockColor":"#bb5555","textColor":"#ffffff","borderColor":"#ffffff","fontWeight":"","fontSize":"","fontFace":""},"containerBlockStyle":{"blockColor":"#8899aa","textColor":"#ffffff","borderColor":"#ffffff","fontWeight":"","fontSize":"","fontFace":""},"commandBlockStyle":{"blockColor":"#9977aa","textColor":"#ffffff","borderColor":"#ffffff","fontWeight":"","fontSize":"","fontFace":""}},"title":"Watermelon Biodiversity","extraCss":"","code":"<?xml version=\"1.0\" encoding=\"utf-8\"?><model version=\"NetLogo 7.0.4\" snapToGrid=\"false\" nlw-version=\"2.16.0\">\n  <code><![CDATA[breed [ seededs seeded ]\nbreed [ unseededs unseeded ]\nbreed [ fungi fungus ]\n\nglobals [colortoinfect probability-fungi-mutate code-infection-button ticktostartinfection]\nfungi-own [ prey-type ]\n\nto setup\n  ca\n  reset-ticks\n  set-default-shape seededs \"seeded-water-melon\"\n  set-default-shape unseededs \"unseeded-water-melon\"\n  ;plant number-of-water-melons\n  set colortoinfect one-of [  green green red red blue yellow magenta ]\n  setup-NetTango\n  coverground\n  \nend\n\nto go\n  go-NetTango\n  ;infect-with-fungus .007\n  ;reproduce 2\n  if ticktostartinfection != 0 [if ticks = ticktostartinfection [start-an-infection-NetTango] ]\n  tick\nend\n\n\nto plant [ num ] ; plants watermelons, seeded red melon on the left (mostly) and unseeded, green melons on the right (mostly)\n  create-seededs num\n  [\n    setxy [pxcor] of one-of patches with [pxcor < 1 ] [pycor] of one-of patches with [pxcor < 1 ]\n    if any? other turtles-here [ setxy random-xcor random-ycor]\n    set color red\n  ]\n  create-unseededs num\n  [\n    setxy [pxcor] of one-of patches with [pxcor > 1 ] [pycor] of one-of patches with [pxcor > 1 ]\n    if any? other turtles-here\n    [\n      setxy random-xcor random-ycor\n    ]\n    set color green\n  ]\nend\n\nto coverground ; sets the color of ground\n  ask patches [ set pcolor brown ]\nend\n\nto create-some-fungi [ num ] ; observer procedure when the \"infect\" button is pressed creat num amount of fungus at the coordinates 29 -14\n  if random 100 < probability-fungi-mutate [set colortoinfect one-of [ green green red blue yellow magenta ]]\n  create-fungi num [ setxy 29 -14 set color grey set size .5 set prey-type colortoinfect set shape \"wheel\"  ]\n\nend\n\nto create-some-fungi-button [ num x y colorofinfection ] ; observer procedure when the \"infect\" button is pressed creat num amount of fungus at the coordinates 29 -14\n  if random 100 < probability-fungi-mutate [set colortoinfect one-of [ green green red blue yellow magenta ]]\n  create-fungi num [ setxy x y  set color grey set size .5 set prey-type colorofinfection set shape \"wheel\"  ]\n\nend\n\nto infect-with-fungus [ move-distance ]; turtle procedure. kills the melon here if the functi's prey-type matches the color of the melon.\n  ;This function calls the infect function\n  ask fungi\n  [\n    ifelse can-move? move-distance\n    [\n      rt random 3\n      lt random 3\n      fd move-distance\n    ]\n    ;else\n    [rt 180]\n\n    if random-float  1000.00 < 0.03\n    [\n      die\n    ]\n  ]\nend\n\nto infect [fungi-spored carrying-capacity]; the function hatches some fungus if the total number of fungus is below a carrying capacity of 50\n  let prey turtles-here with [color = [prey-type] of myself]\n  if prey != nobody[\n    if count fungi < carrying-capacity [\n\n      ask prey\n      [\n        hatch-fungi fungi-spored\n        [\n          set color grey\n          set size .5\n          set prey-type colortoinfect\n          set shape \"wheel\"\n\n        ]\n      ]\n      \n    ]\n  ]\n  ask turtles-here\n  [\n    if color = [prey-type] of myself\n    [\n      die\n    ]\n    \n\n    \n  ]\n  \n\nend\n\nto reproduce [reproduction-probability] ; turtle procedure. Creates a new watermelon in a nearby patch. If that patch is already occupied, then one of the melons dies.\n\n\n  ask unseededs\n  [\n    if random 100 < reproduction-probability\n    [\n      hatch 1\n      [\n        set xcor xcor - 2\n        set ycor ycor - random 4\n        ;set shape \"seeded-water-melon\"\n        set color green\n        if any? other turtles-here with [breed != fungi]\n        [\n          die\n        ]\n      ]\n    ]\n    ]\n\n\n  ask seededs [\n\n           if random 100 < reproduction-probability\n        [\n          hatch 1\n          [\n            set xcor xcor - 1\n            set ycor ycor - random 3\n            ;set shape \"circle\"\n            if random 100 < 22 [set color one-of [ red blue yellow magenta ]]\n            ;ifelse color = green [ set breed unseededs set shape \"unseeded-water-melon\"]  [set breed seededs set shape \"seeded-water-melon\"]\n            if any? other turtles-here with [breed != fungi]\n            [\n              die\n            ]\n          ]\n        ]\n    ]\n\n\n\nend\n\nto-report color-being-infected ;reporter. Lets us know which color the latest fungal wave are infecting\n  let return colortoinfect\n  if colortoinfect = 15 [set return \"red\"]\n  if colortoinfect = 45 [set return \"yellow\"]\n  if colortoinfect = 55 [set return \"green\"]\n  if colortoinfect = 105 [set return \"blue\"]\n  if colortoinfect = 125 [set return \"magenta\"]\n  report return\nend\n\n; Kit Martin 2020\n; --- NETTANGO BEGIN ---\n\n; This block of code was added by the NetTango Web Builder.  If you modify this code\n; and re-import it into the NetTango Web Builder you may lose your changes or need\n; to resolve some errors manually.\n\n; If you do not plan to re-import the model into the NetTango Web Builder then you\n; can safely edit this code however you want, just like a normal NetLogo model.\n\nto go-NetTango\n  ;the procedure that lets you instruct the watermelons\n  ;what to to every minute\n  ask seededs\n  [\n    ; asks the sexual watermelons to reproduce 2% of the time, or whatever you set reproduction probability to.\n    \n    \n               if random 100 < 2\n            [\n              hatch 1\n              [\n                set xcor xcor - 1\n                set ycor ycor - random 3\n                \n                if random 100 < 22 [set color one-of [ red blue yellow magenta ]]\n               \n                if any? other turtles-here with [breed != fungi]\n                [\n                  die\n                ]\n              ]\n            ]\n        \n  ]\n  ask unseededs\n  [\n    ; asks the asexual watermelons to reproduce 2% of the time, or whatever you set reproduction probability to.\n    \n        if random 100 < 2\n        [\n          hatch 1\n          [\n            set xcor xcor - 2\n            set ycor ycor - random 4\n            set color green\n            if any? other turtles-here with [breed != fungi]\n            [\n              die\n            ]\n          ]\n        ]\n        \n    \n  ]\n  ask fungi\n  [\n        if can-move? .007\n        [\n          rt random 3\n          lt random 3\n          fd .007\n        ]\n    infect 1 50\n    set probability-fungi-mutate 0\n  ]\nend\n\nto setup-NetTango\n  ; where you put code you want to happen at the beginng of the simulation\n  \n  create-seededs 8\n    [\n      setxy [pxcor] of one-of patches with [pxcor < 0 ] [pycor] of one-of patches with [pxcor < 0 ]\n      if any? other turtles-here [ setxy random-xcor random-ycor]\n      set color red\n    ]\n  create-unseededs 8\n    [\n      setxy [pxcor] of one-of patches with [pxcor > 0 ] [pycor] of one-of patches with [pxcor > 0 ]\n      if any? other turtles-here\n      [\n        setxy random-xcor random-ycor\n      ]\n      set color green\n    ]\nend\n\nto start-an-infection-NetTango\n  create-some-fungi-button  10 9 0 55 \n  ;ask fungi [ setxy 9 0 set prey-type 55 set colortoinfect 55 \n  ask fungi [if prey-type = 5 [set prey-type one-of [green green red red blue yellow magenta]\n  set colortoinfect one-of [green green red red blue yellow magenta]]]\nend\n; --- NETTANGO END ---]]></code>\n  <widgets>\n    <view x=\"355\" wrappingAllowedX=\"true\" y=\"10\" frameRate=\"30\" minPycor=\"-8\" height=\"451\" showTickCounter=\"true\" patchSize=\"26\" fontSize=\"10\" wrappingAllowedY=\"true\" width=\"554\" tickCounterLabel=\"minutes\" maxPycor=\"8\" updateMode=\"0\" maxPxcor=\"10\" minPxcor=\"-10\"/>\n    <button x=\"5\" y=\"10\" height=\"40\" disableUntilTicks=\"false\" forever=\"false\" kind=\"Observer\" width=\"95\">setup</button>\n    <button x=\"105\" y=\"10\" height=\"40\" disableUntilTicks=\"false\" forever=\"true\" kind=\"Observer\" width=\"95\" display=\"go/pause\">go</button>\n    <plot x=\"5\" autoPlotX=\"true\" yMax=\"10\" autoPlotY=\"true\" yAxis=\"Number of  Watermelons\" y=\"120\" xMin=\"0\" height=\"235\" legend=\"true\" xMax=\"10\" yMin=\"0\" width=\"340\" xAxis=\"Time\" display=\"How many watermelons by color\">\n      <setup/>\n      <update/>\n      <pen interval=\"1\" mode=\"0\" display=\"Green watermelon\" color=\"-13840069\" legend=\"true\">\n        <setup/>\n        <update>plot count turtles with [color = green ]</update>\n      </pen>\n      <pen interval=\"1\" mode=\"0\" display=\"Yellow watermelon\" color=\"-1184463\" legend=\"true\">\n        <setup/>\n        <update>plot count turtles with [color = yellow ]</update>\n      </pen>\n      <pen interval=\"1\" mode=\"0\" display=\"Red watermelons\" color=\"-2674135\" legend=\"true\">\n        <setup/>\n        <update>plot count turtles with [color = red ]</update>\n      </pen>\n      <pen interval=\"1\" mode=\"0\" display=\"Magenta watermelons\" color=\"-5825686\" legend=\"true\">\n        <setup/>\n        <update>plot count turtles with [color = magenta ]</update>\n      </pen>\n      <pen interval=\"1\" mode=\"0\" display=\"Blue watermelons\" color=\"-13345367\" legend=\"true\">\n        <setup/>\n        <update>plot count turtles with [color = blue ]</update>\n      </pen>\n    </plot>\n    <button x=\"205\" y=\"10\" height=\"40\" disableUntilTicks=\"false\" forever=\"false\" kind=\"Observer\" width=\"125\" display=\"start an infection\">start-an-infection-NetTango\n</button>\n    <monitor x=\"5\" precision=\"0\" y=\"55\" height=\"60\" fontSize=\"12\" width=\"190\" display=\"the fungus is now targeting:\">color-being-infected</monitor>\n  </widgets>\n  <info><![CDATA[## WHAT IS IT?\n\nStudents investigate seedless watermelon (artificial asexual reproduction via grafting) and seeded watermelon (naturally reproducing sexually) to see how they are affected when a fungus is introduced into the population. What can be done to help the watermelons survive the fungus? \n\nVideo about how seeded fruit is made: https://www.youtube.com/watch?v=ewtlsEb4Vgk&feature=youtu.be\n\nSince the seedless watermelon is grafted and reproduced asexually there is little to no biodiversity which means that a fungus could wipe out the entire population. The seeded watermelon has the ability to mutate and therefore has biodiversity. While the fungus may kill some of the seeded watermelons, the biodiversity will give them a much greater chance of surviving the fungus. The watermelon that survives the population will reproduce and since they reproduce they are likely (but not guaranteed) to have the mutation that allows them to survive the fungus. As the seeded watermelon continues to reproduce, the watermelon with the mutation to survive the fungus will survive but its offspring without the mutation will die. \n\n\n## HOW IT WORKS\nSeeded watermelons reproduce sexually and therefore mutate which causes biodiversity. Seedless watermelons are artificially reproduced asexually through grafting and therefore has a very minimal genetic mutation. If a disease or fungus is introduced to both populations then the genetic variation in the seedless \n\n## HOW TO USE IT\n\nSeeded watermelon (circles of one color) -- reproduce at a rate called reproduction rate (0 to 100) which would be smaller than the reproduction rate of the seedless watermelon. Ability to mutate using a mutation rate (0 to 100). The mutation rate would change the color of the watermelon to show the mutation. \n\nSeedless watermelon (circles of a different color which could be the same or a lighter shade of one of the mutations because a mutation could be the seedless watermelon) -- reproduce at a rate called reproduction rate (0 to 100) which would be bigger than the reproduction rate of the seeded watermelon. Able to mutate using a mutation rate (0 to 100) which would be much smaller than the mutation rate of the seeded watermelon but I would be relying on the student to know this from previous lessons. \n\n## THINGS TO NOTICE\n\nThe fungus or disease is a button that students could introduce at varying times. The fungus is programmed to kill plants of a certain color. That color is randomly selected and can be the color of the seeded watermelon, seedless watermelon, or any of the mutations. The fungus or disease continues to float around via grey spores to spread as soon as it is introduced. It moves around and if it comes in contact with a particular color then it has a certain chance of killing that color\n\n\n## THINGS TO TRY\n\nTrying varying the probability of mutation. Try introducing fungi mutation. How do these effect the proportion of watermelons by color?\n\nWrite what they see in a graphic organizer (still exploring Bozeman to find something I like for this). \n\n## EXTENDING THE MODEL\n\ntry making it so  fungus/disease  kills the plant it comes into contact with only 25% of the time \nAlo, think about alternative means for the fungus  spread from one plant to another and how that could change things?\n\nOne thing to think about is how the genes get passed from the parent to offspring in the sexually reproduced, seeded watermelon. Currently, a watermelon hatches another watermelon with a percent chance their offspring will change color. But, in sexually reproduced plants, parents that survive will pass down half of their genes to their offspring and so we’ll start to see the favored genes that aren’t susceptible to the disease/fungus persevere. But this could involve mixing of colors, or keeping track of lineage. Try extending the model by building some of those features. \n\nThis gene function goes beyond  the scope of what you need to understand in middle school, but it is important in the design of the model, and evolution. \n\n\n## CREDITS AND REFERENCES\n\nKit Martin (2020). Water Melons.]]></info>\n  <turtleShapes>\n    <shape name=\"default\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"5\"/>\n        <point x=\"40\" y=\"250\"/>\n        <point x=\"150\" y=\"205\"/>\n        <point x=\"260\" y=\"250\"/>\n      </polygon>\n    </shape>\n    <shape name=\"airplane\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"0\"/>\n        <point x=\"135\" y=\"15\"/>\n        <point x=\"120\" y=\"60\"/>\n        <point x=\"120\" y=\"105\"/>\n        <point x=\"15\" y=\"165\"/>\n        <point x=\"15\" y=\"195\"/>\n        <point x=\"120\" y=\"180\"/>\n        <point x=\"135\" y=\"240\"/>\n        <point x=\"105\" y=\"270\"/>\n        <point x=\"120\" y=\"285\"/>\n        <point x=\"150\" y=\"270\"/>\n        <point x=\"180\" y=\"285\"/>\n        <point x=\"210\" y=\"270\"/>\n        <point x=\"165\" y=\"240\"/>\n        <point x=\"180\" y=\"180\"/>\n        <point x=\"285\" y=\"195\"/>\n        <point x=\"285\" y=\"165\"/>\n        <point x=\"180\" y=\"105\"/>\n        <point x=\"180\" y=\"60\"/>\n        <point x=\"165\" y=\"15\"/>\n      </polygon>\n    </shape>\n    <shape name=\"arrow\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"0\"/>\n        <point x=\"0\" y=\"150\"/>\n        <point x=\"105\" y=\"150\"/>\n        <point x=\"105\" y=\"293\"/>\n        <point x=\"195\" y=\"293\"/>\n        <point x=\"195\" y=\"150\"/>\n        <point x=\"300\" y=\"150\"/>\n      </polygon>\n    </shape>\n    <shape name=\"box\" rotatable=\"false\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"285\"/>\n        <point x=\"285\" y=\"225\"/>\n        <point x=\"285\" y=\"75\"/>\n        <point x=\"150\" y=\"135\"/>\n      </polygon>\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"135\"/>\n        <point x=\"15\" y=\"75\"/>\n        <point x=\"150\" y=\"15\"/>\n        <point x=\"285\" y=\"75\"/>\n      </polygon>\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"15\" y=\"75\"/>\n        <point x=\"15\" y=\"225\"/>\n        <point x=\"150\" y=\"285\"/>\n        <point x=\"150\" y=\"135\"/>\n      </polygon>\n      <line endX=\"150\" startY=\"285\" marked=\"false\" color=\"255\" endY=\"135\" startX=\"150\"/>\n      <line endX=\"15\" startY=\"135\" marked=\"false\" color=\"255\" endY=\"75\" startX=\"150\"/>\n      <line endX=\"285\" startY=\"135\" marked=\"false\" color=\"255\" endY=\"75\" startX=\"150\"/>\n    </shape>\n    <shape name=\"bug\" rotatable=\"true\" editableColorIndex=\"0\">\n      <circle x=\"96\" y=\"182\" marked=\"true\" color=\"-1920102913\" diameter=\"108\" filled=\"true\"/>\n      <circle x=\"110\" y=\"127\" marked=\"true\" color=\"-1920102913\" diameter=\"80\" filled=\"true\"/>\n      <circle x=\"110\" y=\"75\" marked=\"true\" color=\"-1920102913\" diameter=\"80\" filled=\"true\"/>\n      <line endX=\"80\" startY=\"100\" marked=\"true\" color=\"-1920102913\" endY=\"30\" startX=\"150\"/>\n      <line endX=\"220\" startY=\"100\" marked=\"true\" color=\"-1920102913\" endY=\"30\" startX=\"150\"/>\n    </shape>\n    <shape name=\"butterfly\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"165\"/>\n        <point x=\"209\" y=\"199\"/>\n        <point x=\"225\" y=\"225\"/>\n        <point x=\"225\" y=\"255\"/>\n        <point x=\"195\" y=\"270\"/>\n        <point x=\"165\" y=\"255\"/>\n        <point x=\"150\" y=\"240\"/>\n      </polygon>\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"165\"/>\n        <point x=\"89\" y=\"198\"/>\n        <point x=\"75\" y=\"225\"/>\n        <point x=\"75\" y=\"255\"/>\n        <point x=\"105\" y=\"270\"/>\n        <point x=\"135\" y=\"255\"/>\n        <point x=\"150\" y=\"240\"/>\n      </polygon>\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"139\" y=\"148\"/>\n        <point x=\"100\" y=\"105\"/>\n        <point x=\"55\" y=\"90\"/>\n        <point x=\"25\" y=\"90\"/>\n        <point x=\"10\" y=\"105\"/>\n        <point x=\"10\" y=\"135\"/>\n        <point x=\"25\" y=\"180\"/>\n        <point x=\"40\" y=\"195\"/>\n        <point x=\"85\" y=\"194\"/>\n        <point x=\"139\" y=\"163\"/>\n      </polygon>\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"162\" y=\"150\"/>\n        <point x=\"200\" y=\"105\"/>\n        <point x=\"245\" y=\"90\"/>\n        <point x=\"275\" y=\"90\"/>\n        <point x=\"290\" y=\"105\"/>\n        <point x=\"290\" y=\"135\"/>\n        <point x=\"275\" y=\"180\"/>\n        <point x=\"260\" y=\"195\"/>\n        <point x=\"215\" y=\"195\"/>\n        <point x=\"162\" y=\"165\"/>\n      </polygon>\n      <polygon color=\"255\" filled=\"true\" marked=\"false\">\n        <point x=\"150\" y=\"255\"/>\n        <point x=\"135\" y=\"225\"/>\n        <point x=\"120\" y=\"150\"/>\n        <point x=\"135\" y=\"120\"/>\n        <point x=\"150\" y=\"105\"/>\n        <point x=\"165\" y=\"120\"/>\n        <point x=\"180\" y=\"150\"/>\n        <point x=\"165\" y=\"225\"/>\n      </polygon>\n      <circle x=\"135\" y=\"90\" marked=\"false\" color=\"255\" diameter=\"30\" filled=\"true\"/>\n      <line endX=\"195\" startY=\"105\" marked=\"false\" color=\"255\" endY=\"60\" startX=\"150\"/>\n      <line endX=\"105\" startY=\"105\" marked=\"false\" color=\"255\" endY=\"60\" startX=\"150\"/>\n    </shape>\n    <shape name=\"car\" rotatable=\"false\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"300\" y=\"180\"/>\n        <point x=\"279\" y=\"164\"/>\n        <point x=\"261\" y=\"144\"/>\n        <point x=\"240\" y=\"135\"/>\n        <point x=\"226\" y=\"132\"/>\n        <point x=\"213\" y=\"106\"/>\n        <point x=\"203\" y=\"84\"/>\n        <point x=\"185\" y=\"63\"/>\n        <point x=\"159\" y=\"50\"/>\n        <point x=\"135\" y=\"50\"/>\n        <point x=\"75\" y=\"60\"/>\n        <point x=\"0\" y=\"150\"/>\n        <point x=\"0\" y=\"165\"/>\n        <point x=\"0\" y=\"225\"/>\n        <point x=\"300\" y=\"225\"/>\n        <point x=\"300\" y=\"180\"/>\n      </polygon>\n      <circle x=\"180\" y=\"180\" marked=\"false\" color=\"255\" diameter=\"90\" filled=\"true\"/>\n      <circle x=\"30\" y=\"180\" marked=\"false\" color=\"255\" diameter=\"90\" filled=\"true\"/>\n      <polygon color=\"255\" filled=\"true\" marked=\"false\">\n        <point x=\"162\" y=\"80\"/>\n        <point x=\"132\" y=\"78\"/>\n        <point x=\"134\" y=\"135\"/>\n        <point x=\"209\" y=\"135\"/>\n        <point x=\"194\" y=\"105\"/>\n        <point x=\"189\" y=\"96\"/>\n        <point x=\"180\" y=\"89\"/>\n      </polygon>\n      <circle x=\"47\" y=\"195\" marked=\"true\" color=\"-1920102913\" diameter=\"58\" filled=\"true\"/>\n      <circle x=\"195\" y=\"195\" marked=\"true\" color=\"-1920102913\"