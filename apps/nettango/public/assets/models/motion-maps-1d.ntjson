{"spaces":[{"id":0,"spaceId":"ntb-defs-0","name":"Block Space 0","width":1000,"height":500,"defs":{"version":7,"height":500,"width":1000,"blocks":[{"id":0,"action":"change","isRequired":false,"placement":"child","type":"nlogo:command","format":"set go-commands lput [\"{0}\" {1} {P0}] go-commands","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#47c4c3","textColor":"#ffffff","borderColor":"#000000","font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[{"name":"variable","unit":"","type":"select","default":"10","quoteValues":"smart-quote","values":[{"actual":"x-velocity","display":null}],"value":"10"},{"name":"value","unit":"","type":"num","default":"10","value":"10"}],"properties":[{"name":"for this many seconds","unit":"seconds","type":"num","default":"10","value":"10"}],"fontWeight":400,"fontSize":12,"fontFace":"'Poppins', sans-serif","start":false,"control":false},{"id":1,"action":"go","isRequired":true,"placement":"starter","type":"nlogo:procedure","format":"to load-go-commands","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":1,"note":null,"blockColor":"#dc2f2f","textColor":"#ffffff","borderColor":"#000000","font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[],"fontWeight":400,"fontSize":12,"fontFace":"'Poppins', sans-serif","start":true,"control":false},{"id":2,"action":"setup","isRequired":true,"placement":"starter","type":"nlogo:procedure","format":"to load-setup-commands","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":1,"note":null,"blockColor":"#e12c34","textColor":"#ffffff","borderColor":"#000000","font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[],"fontWeight":400,"fontSize":12,"fontFace":"'Poppins', sans-serif","start":true,"control":false},{"id":3,"action":"set starting position","isRequired":false,"placement":"child","type":"nlogo:command","format":"set setup-commands lput [\"initial-position\" {0} -1] setup-commands","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#ffd579","textColor":"#ffffff","borderColor":"#000000","font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[{"name":"start","unit":"","step":1,"random":false,"default":10,"type":"range","min":0,"max":300,"value":10}],"properties":[],"fontWeight":400,"fontSize":12,"fontFace":"'Poppins', sans-serif","start":false,"control":false},{"id":4,"action":"set draw interval","isRequired":false,"placement":"child","type":"nlogo:command","format":"set setup-commands lput [\"draw-interval\" {0} -1] setup-commands","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#ffd579","textColor":"#ffffff","borderColor":"#000000","font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[{"name":"start","unit":"","step":0.2,"random":false,"default":20,"type":"range","min":0,"max":5,"value":20}],"properties":[],"fontWeight":400,"fontSize":12,"fontFace":"'Poppins', sans-serif","start":false,"control":false}],"menuConfig":{"mainGroup":{"isCollapsed":false,"order":[0,1,2,3,4]},"tagGroups":[]},"program":{"chains":[]},"chainOpen":null,"chainClose":"end","variables":[],"expressions":[{"name":"true","type":"bool","arguments":[],"format":null},{"name":"false","type":"bool","arguments":[],"format":null},{"name":"AND","type":"bool","arguments":["bool","bool"],"format":"({0} and {1})"},{"name":"OR","type":"bool","arguments":["bool","bool"],"format":"({0} or {1})"},{"name":"NOT","type":"bool","arguments":["bool"],"format":"(not {0})"},{"name":">","type":"bool","arguments":["num","num"],"format":null},{"name":">=","type":"bool","arguments":["num","num"],"format":null},{"name":"<","type":"bool","arguments":["num","num"],"format":null},{"name":"<=","type":"bool","arguments":["num","num"],"format":null},{"name":"!=","type":"bool","arguments":["num","num"],"format":null},{"name":"=","type":"bool","arguments":["num","num"],"format":null},{"name":"+","type":"num","arguments":["num","num"],"format":null},{"name":"-","type":"num","arguments":["num","num"],"format":null},{"name":"×","type":"num","arguments":["num","num"],"format":"({0} * {1})"},{"name":"/","type":"num","arguments":["num","num"],"format":null},{"name":"random","type":"num","arguments":["num"],"format":"random-float {0}"}]},"netLogoCode":"to load-go-commands\nend\n\nto load-setup-commands\nend","netLogoDisplay":"to load-go-commands\nend\n\nto load-setup-commands\nend"}],"netTangoOptions":{"workspaceBelow":false,"showCode":true,"enablePlayModeDefinitionChanges":false,"enableCodeTips":true},"netLogoOptions":{"commandCenterTab":true,"codeTab":true,"infoTab":true,"inspectionTab":true,"speedBar":false,"fileButtons":false,"authoring":true,"poweredBy":true},"blockStyles":null,"title":"MYOMM_NetTango","extraCss":"","code":"<?xml version=\"1.0\" encoding=\"utf-8\"?><model version=\"NetLogo 7.0.4\" snapToGrid=\"false\" nlw-version=\"2.16.0\">\n  <code><![CDATA[breed[cars car]                                    ;1.  Create the car breed.\nbreed[arrowheads arrowhead]\n\nglobals [                                          ;2.  Create variables that can be used anywhere in the program.\n  deltat                                           ;3.  Variable to set time increment.\n  any-movement?\n  dot-level\n\n  setup-commands\n  go-commands\n  stop-watch\n]\n\ncars-own[                                          ;10. Variables keep track of each car's position, velocity, and acceleration.\n  vx\n  prev-velocity\n  my-velocity-arrow\n  my-accel-arrow\n]\n\nto setup                                           ;11.  Sets up initial conditions and values linked to the setup button on the front screen.\n  clear-all\n\n  set setup-commands []\n  set go-commands []\n\n  set dot-level 9\n\n  ask patches [ if pxcor mod 50 = 0 [ set pcolor white ] ]\n\n  create-cars 1 [                              ;13.  Creates the cars, shape, color, size and initial conditions.\n    set shape \"car\"\n    set color red\n    set size 15\n\n    if programming? [\n    load-setup-commands\n\n    while [not empty? setup-commands] [\n      let current first setup-commands\n      set setup-commands but-first setup-commands\n      process-command current\n    ]\n    load-go-commands\n    ]\n\n    set vx x-velocity\n    set prev-velocity vx\n    ifelse x-velocity < 0 [ set heading 270 ] [ set heading 90 ]\n\n    setxy initial-position dot-level - 6\n\n    hatch-arrowheads 1 [\n      set color cyan\n      set size 10\n      set hidden? true\n      ask myself [set my-velocity-arrow myself]\n      create-link-with myself [\n        set thickness 2\n        set color cyan\n        set hidden? true\n      ]\n    ]\n  ]\n\n  set deltat 0.1\n\n  set any-movement? false\n  reset-ticks                                      ;16.  Resets the tick counter on the front screen.\nend\n\nto process-command [current]\n  (ifelse\n    item 0 current = \"initial-position\" [ set initial-position (item 1 current) ]\n    item 0 current = \"draw-interval\" [ set draw-interval (item 1 current) ]\n    item 0 current = \"x-velocity\" [ set x-velocity (item 1 current) set stop-watch (item 2 current) / deltat]\n  )\nend\n\nto go                                              ;17.  Sets up the statements linked to the go button on the front screen.\n  if dot-level > (max-pycor - 1) [ user-message \"Your parameters have caused the motion map to be too big. Please try again.\" stop ]\n\n  ask cars [                                     ;19.  Inquire cars to do some action.\n\n    if programming? and stop-watch = 0 [\n\n    ifelse not empty? go-commands [\n      let current first go-commands\n      set go-commands but-first go-commands\n\n      process-command current\n\n      ][ stop ]\n    ]\n\n    set vx x-velocity\n    ifelse vx < 0 [ set shape \"car-backward\" set heading 270 ] [ set shape \"car\" set heading 90 ]\n\n    if ticks mod (draw-interval / deltat) = 0 [\n      if prev-velocity * vx < 0 [ set dot-level dot-level + 6 ]\n      set prev-velocity vx\n      draw-velocity-arrow\n      hatch 1 [\n        set ycor dot-level\n        set shape \"dot\"\n        set size 10\n        set color yellow\n        stamp die\n      ]\n      if vx = 0 [ set dot-level dot-level + 6 ]\n    ]\n\n    move                                     ;20.  Call procedure to move cars.\n\n  ]\n\n  ifelse not any-movement? [ stop ] [ set any-movement? false ]\n\n  if stop-watch > 0 [ set stop-watch stop-watch - 1 ]\n  tick\nend\n\n\nto move                                        ;24.  Routine to move the car's position and calculate new velocity.\n  let fd-step vx * deltat\n  ifelse fd-step + xcor > max-pxcor or fd-step + xcor < min-pxcor [ set any-movement? false user-message \"Your car has hit the edge of the world. Try adjusting your parameters.\" stop ] [ set any-movement? true ]\n  fd abs fd-step\nend\n\nto draw-velocity-arrow\n  if vx != 0 [\n    set ycor dot-level\n    ask my-velocity-arrow [\n\n      set heading [heading] of myself\n      let arrow-placement [xcor] of myself + ([vx] of myself * deltat * 5)\n      if arrow-placement > max-pxcor or arrow-placement < min-pxcor [user-message \"Your car has hit the edge of the world. Try adjusting your parameters.\"  stop ]\n      set xcor arrow-placement\n\n      set ycor [ycor] of myself\n      set hidden? false\n      stamp\n      set hidden? true\n      ask my-links [\n        set hidden? false\n        stamp\n        set hidden? true\n      ]\n    ]\n    set ycor 3\n  ]\nend\n; --- NETTANGO BEGIN ---\n\n; This block of code was added by the NetTango Web Builder.  If you modify this code\n; and re-import it into the NetTango Web Builder you may lose your changes or need\n; to resolve some errors manually.\n\n; If you do not plan to re-import the model into the NetTango Web Builder then you\n; can safely edit this code however you want, just like a normal NetLogo model.\n\nto load-go-commands\nend\n\nto load-setup-commands\nend\n; --- NETTANGO END ---]]></code>\n  <widgets>\n    <view x=\"230\" wrappingAllowedX=\"false\" y=\"330\" frameRate=\"30\" minPycor=\"0\" height=\"211\" showTickCounter=\"true\" patchSize=\"2\" fontSize=\"10\" wrappingAllowedY=\"false\" width=\"610\" tickCounterLabel=\"ticks\" maxPycor=\"100\" updateMode=\"1\" maxPxcor=\"300\" minPxcor=\"0\"/>\n    <button x=\"5\" y=\"130\" height=\"40\" disableUntilTicks=\"false\" forever=\"false\" kind=\"Observer\" width=\"105\">setup</button>\n    <button x=\"115\" y=\"130\" height=\"40\" disableUntilTicks=\"false\" forever=\"true\" kind=\"Observer\" width=\"110\">go</button>\n    <slider x=\"5\" step=\"2\" y=\"75\" max=\"50\" width=\"220\" display=\"x-velocity\" height=\"50\" min=\"-50\" direction=\"Horizontal\" default=\"10\" variable=\"x-velocity\"/>\n    <note x=\"5\" y=\"55\" height=\"18\" backgroundDark=\"0\" fontSize=\"11\" width=\"220\" markdown=\"false\" textColorLight=\"-16777216\" backgroundLight=\"0\">Set initial velocity for Car0.</note>\n    <note x=\"5\" y=\"355\" height=\"19\" backgroundDark=\"0\" fontSize=\"15\" width=\"150\" markdown=\"false\" textColorLight=\"-13403783\" backgroundLight=\"0\">Cyan = Velocity</note>\n    <note x=\"5\" y=\"335\" height=\"19\" textColorLight=\"-16777216\" fontSize=\"15\" width=\"150\" markdown=\"false\">Yellow = Position</note>\n    <slider x=\"5\" step=\"1\" y=\"220\" max=\"5\" width=\"220\" display=\"draw-interval\" height=\"50\" min=\"0\" direction=\"Horizontal\" default=\"1\" variable=\"draw-interval\"/>\n    <switch x=\"5\" y=\"10\" height=\"40\" on=\"true\" variable=\"programming?\" width=\"220\" display=\"programming?\"/>\n    <slider x=\"230\" step=\"1\" y=\"275\" max=\"300\" width=\"610\" display=\"initial-position\" height=\"50\" min=\"0\" direction=\"Horizontal\" default=\"0\" variable=\"initial-position\"/>\n    <button x=\"5\" y=\"175\" height=\"40\" disableUntilTicks=\"false\" forever=\"false\" kind=\"Observer\" width=\"220\" display=\"Save Motion Map\">export-view (word user-input \"Enter a name for your motion map (like 'mymotionmap')\" \".png\")</button>\n    <plot x=\"575\" autoPlotX=\"false\" yMax=\"50\" autoPlotY=\"false\" yAxis=\"Velocity (m / s)\" y=\"10\" xMin=\"0\" height=\"235\" legend=\"false\" xMax=\"20\" yMin=\"-50\" width=\"340\" xAxis=\"Time (s)\" display=\"Velocity over Time\">\n      <setup/>\n      <update/>\n      <pen interval=\"1\" mode=\"0\" display=\"default\" color=\"-16777216\" legend=\"true\">\n        <setup/>\n        <update>if any? turtles [ plotxy ticks * 0.1 [vx] of car 0 ]</update>\n      </pen>\n    </plot>\n    <plot x=\"230\" autoPlotX=\"false\" yMax=\"300\" autoPlotY=\"false\" yAxis=\"Position (m)\" y=\"10\" xMin=\"0\" height=\"235\" legend=\"false\" xMax=\"20\" yMin=\"0\" width=\"340\" xAxis=\"Time (s)\" display=\"Position over Time\">\n      <setup/>\n      <update/>\n      <pen interval=\"1\" mode=\"0\" display=\"default\" color=\"-16777216\" legend=\"true\">\n        <setup/>\n        <update>if any? turtles [ plotxy (ticks * deltat) [xcor] of car 0 ]</update>\n      </pen>\n    </plot>\n  </widgets>\n  <info>## WHAT IS IT?\n\n(A graph of position velocity and acceleration for up to 10 cars moving horizontally.)\n\n## HOW IT WORKS\n\n(Given initial conditions set by the user the cars will move following kinematic equations.)\n\n## HOW TO USE IT\n\n(Use the model to understand how graphical representation describes kinematic motion.)\n\n## THINGS TO NOTICE\n\n(Compare the graphs of 2 cars moving with different initial values.)\n\n## THINGS TO TRY\n\n(Set the increments of velocity and acceleration to different values and see how the individual motions and graphs differ.)\n\n## EXTENDING THE MODEL\n\n(--)\n\n## NETLOGO FEATURES\n\n(Can update many cars at once with their own individual values.)\n\n## RELATED MODELS\n\n(--)\n\n## CREDITS AND REFERENCES\n\n(Coded by Neil Schmidgall for the Physics Classroom.)</info>\n  <turtleShapes>\n    <shape name=\"default\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"5\"/>\n        <point x=\"40\" y=\"250\"/>\n        <point x=\"150\" y=\"205\"/>\n        <point x=\"260\" y=\"250\"/>\n      </polygon>\n    </shape>\n    <shape name=\"airplane\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"0\"/>\n        <point x=\"135\" y=\"15\"/>\n        <point x=\"120\" y=\"60\"/>\n        <point x=\"120\" y=\"105\"/>\n        <point x=\"15\" y=\"165\"/>\n        <point x=\"15\" y=\"195\"/>\n        <point x=\"120\" y=\"180\"/>\n        <point x=\"135\" y=\"240\"/>\n        <point x=\"105\" y=\"270\"/>\n        <point x=\"120\" y=\"285\"/>\n        <point x=\"150\" y=\"270\"/>\n        <point x=\"180\" y=\"285\"/>\n        <point x=\"210\" y=\"270\"/>\n        <point x=\"165\" y=\"240\"/>\n        <point x=\"180\" y=\"180\"/>\n        <point x=\"285\" y=\"195\"/>\n        <point x=\"285\" y=\"165\"/>\n        <point x=\"180\" y=\"105\"/>\n        <point x=\"180\" y=\"60\"/>\n        <point x=\"165\" y=\"15\"/>\n      </polygon>\n    </shape>\n    <shape name=\"arrow\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"0\"/>\n        <point x=\"0\" y=\"150\"/>\n        <point x=\"105\" y=\"150\"/>\n        <point x=\"105\" y=\"293\"/>\n        <point x=\"195\" y=\"293\"/>\n        <point x=\"195\" y=\"150\"/>\n        <point x=\"300\" y=\"150\"/>\n      </polygon>\n    </shape>\n    <shape name=\"box\" rotatable=\"false\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"285\"/>\n        <point x=\"285\" y=\"225\"/>\n        <point x=\"285\" y=\"75\"/>\n        <point x=\"150\" y=\"135\"/>\n      </polygon>\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"135\"/>\n        <point x=\"15\" y=\"75\"/>\n        <point x=\"150\" y=\"15\"/>\n        <point x=\"285\" y=\"75\"/>\n      </polygon>\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"15\" y=\"75\"/>\n        <point x=\"15\" y=\"225\"/>\n        <point x=\"150\" y=\"285\"/>\n        <point x=\"150\" y=\"135\"/>\n      </polygon>\n      <line endX=\"150\" startY=\"285\" marked=\"false\" color=\"255\" endY=\"135\" startX=\"150\"/>\n      <line endX=\"15\" startY=\"135\" marked=\"false\" color=\"255\" endY=\"75\" startX=\"150\"/>\n      <line endX=\"285\" startY=\"135\" marked=\"false\" color=\"255\" endY=\"75\" startX=\"150\"/>\n    </shape>\n    <shape name=\"bug\" rotatable=\"true\" editableColorIndex=\"0\">\n      <circle x=\"96\" y=\"182\" marked=\"true\" color=\"-1920102913\" diameter=\"108\" filled=\"true\"/>\n      <circle x=\"110\" y=\"127\" marked=\"true\" color=\"-1920102913\" diameter=\"80\" filled=\"true\"/>\n      <circle x=\"110\" y=\"75\" marked=\"true\" color=\"-1920102913\" diameter=\"80\" filled=\"true\"/>\n      <line endX=\"80\" startY=\"100\" marked=\"true\" color=\"-1920102913\" endY=\"30\" startX=\"150\"/>\n      <line endX=\"220\" startY=\"100\" marked=\"true\" color=\"-1920102913\" endY=\"30\" startX=\"150\"/>\n    </shape>\n    <shape name=\"butterfly\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"165\"/>\n        <point x=\"209\" y=\"199\"/>\n        <point x=\"225\" y=\"225\"/>\n        <point x=\"225\" y=\"255\"/>\n        <point x=\"195\" y=\"270\"/>\n        <point x=\"165\" y=\"255\"/>\n        <point x=\"150\" y=\"240\"/>\n      </polygon>\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"165\"/>\n        <point x=\"89\" y=\"198\"/>\n        <point x=\"75\" y=\"225\"/>\n        <point x=\"75\" y=\"255\"/>\n        <point x=\"105\" y=\"270\"/>\n        <point x=\"135\" y=\"255\"/>\n        <point x=\"150\" y=\"240\"/>\n      </polygon>\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"139\" y=\"148\"/>\n        <point x=\"100\" y=\"105\"/>\n        <point x=\"55\" y=\"90\"/>\n        <point x=\"25\" y=\"90\"/>\n        <point x=\"10\" y=\"105\"/>\n        <point x=\"10\" y=\"135\"/>\n        <point x=\"25\" y=\"180\"/>\n        <point x=\"40\" y=\"195\"/>\n        <point x=\"85\" y=\"194\"/>\n        <point x=\"139\" y=\"163\"/>\n      </polygon>\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"162\" y=\"150\"/>\n        <point x=\"200\" y=\"105\"/>\n        <point x=\"245\" y=\"90\"/>\n        <point x=\"275\" y=\"90\"/>\n        <point x=\"290\" y=\"105\"/>\n        <point x=\"290\" y=\"135\"/>\n        <point x=\"275\" y=\"180\"/>\n        <point x=\"260\" y=\"195\"/>\n        <point x=\"215\" y=\"195\"/>\n        <point x=\"162\" y=\"165\"/>\n      </polygon>\n      <polygon color=\"255\" filled=\"true\" marked=\"false\">\n        <point x=\"150\" y=\"255\"/>\n        <point x=\"135\" y=\"225\"/>\n        <point x=\"120\" y=\"150\"/>\n        <point x=\"135\" y=\"120\"/>\n        <point x=\"150\" y=\"105\"/>\n        <point x=\"165\" y=\"120\"/>\n        <point x=\"180\" y=\"150\"/>\n        <point x=\"165\" y=\"225\"/>\n      </polygon>\n      <circle x=\"135\" y=\"90\" marked=\"false\" color=\"255\" diameter=\"30\" filled=\"true\"/>\n      <line endX=\"195\" startY=\"105\" marked=\"false\" color=\"255\" endY=\"60\" startX=\"150\"/>\n      <line endX=\"105\" startY=\"105\" marked=\"false\" color=\"255\" endY=\"60\" startX=\"150\"/>\n    </shape>\n    <shape name=\"car\" rotatable=\"false\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" 