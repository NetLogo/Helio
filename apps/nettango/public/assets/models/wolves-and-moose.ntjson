:null,"blockColor":"#66a2c7","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[{"name":"max-turn-angle","unit":"°","step":1,"random":false,"default":50,"type":"range","min":0,"max":90,"value":50}],"start":false,"control":false},{"id":3,"action":"right","isRequired":false,"placement":"child","type":"nlogo:command","format":"right random {P0}","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":null,"textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[{"name":"max-turn-angle","unit":"°","step":1,"random":false,"default":50,"type":"range","min":0,"max":90,"value":50}],"start":false,"control":false},{"id":4,"action":"pen down","isRequired":false,"placement":"child","type":"nlogo:command","format":"pen-down","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":null,"textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[],"start":false,"control":false},{"id":5,"action":"pen up","isRequired":false,"placement":"child","type":"nlogo:command","format":"pen-up","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":null,"textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[],"start":false,"control":false},{"id":9,"action":"flee","isRequired":false,"placement":"child","type":"nlogo:command","format":"flee","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":1,"note":null,"blockColor":null,"textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[],"control":false},{"id":8,"action":"chance","isRequired":false,"placement":"child","type":"nlogo:if","format":"if random 100 < {0}","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":null,"textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[{"action":null,"open":"[","close":"]","allowedTags":{"type":"unrestricted"}}],"params":[{"name":"percent","unit":"%","step":0.1,"random":false,"default":20,"type":"range","min":0,"max":100,"value":20}],"properties":[],"start":false,"control":true},{"id":6,"action":"multiply","isRequired":false,"placement":"child","type":"nlogo:command","format":"hatch 1 [ rt random-float 360 fd 1 ]","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#9977aa","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[],"start":false,"control":false},{"id":7,"action":"die","isRequired":false,"placement":"child","type":"nlogo:command","format":"die","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#9977aa","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[],"start":false,"control":false}],"menuConfig":{"mainGroup":{"isCollapsed":false,"order":[0,1,2,3,4,5,9,8,6,7]},"tagGroups":[]},"program":{"chains":[]},"chainOpen":null,"chainClose":"end","variables":[],"expressions":[{"name":"true","type":"bool","arguments":[],"format":null},{"name":"false","type":"bool","arguments":[],"format":null},{"name":"AND","type":"bool","arguments":["bool","bool"],"format":"({0} and {1})"},{"name":"OR","type":"bool","arguments":["bool","bool"],"format":"({0} or {1})"},{"name":"NOT","type":"bool","arguments":["bool"],"format":"(not {0})"},{"name":">","type":"bool","arguments":["num","num"],"format":null},{"name":">=","type":"bool","arguments":["num","num"],"format":null},{"name":"<","type":"bool","arguments":["num","num"],"format":null},{"name":"<=","type":"bool","arguments":["num","num"],"format":null},{"name":"!=","type":"bool","arguments":["num","num"],"format":null},{"name":"=","type":"bool","arguments":["num","num"],"format":null},{"name":"+","type":"num","arguments":["num","num"],"format":null},{"name":"-","type":"num","arguments":["num","num"],"format":null},{"name":"×","type":"num","arguments":["num","num"],"format":"({0} * {1})"},{"name":"/","type":"num","arguments":["num","num"],"format":null},{"name":"random","type":"num","arguments":["num"],"format":"random-float {0}"}]},"netLogoCode":"to moose-actions\nend","netLogoDisplay":"to moose-actions\nend"}],"netTangoOptions":{"workspaceBelow":true,"showCode":true,"enablePlayModeDefinitionChanges":false,"enableCodeTips":true},"netLogoOptions":{"commandCenterTab":true,"codeTab":true,"infoTab":true,"inspectionTab":true,"speedBar":true,"fileButtons":true,"authoring":true,"poweredBy":false},"blockStyles":{"starterBlockStyle":{"blockColor":"#bb5555","textColor":"#ffffff","borderColor":"#ffffff","fontWeight":"","fontSize":"","fontFace":""},"containerBlockStyle":{"blockColor":"#8899aa","textColor":"#ffffff","borderColor":"#ffffff","fontWeight":"","fontSize":"","fontFace":""},"commandBlockStyle":{"blockColor":"#66a2c7","textColor":"#ffffff","borderColor":"#ffffff","fontWeight":"","fontSize":"","fontFace":""}},"title":"wolf moose predation","extraCss":"","code":"<?xml version=\"1.0\" encoding=\"utf-8\"?><model version=\"NetLogo 7.0.4\" snapToGrid=\"false\" nlw-version=\"2.16.0\">\n  <code><![CDATA[globals [ max-moose ; don't let moose population grow too large\n          max-wolves ; don't let wolves population grow too large\n]\n\nbreed [ moose a-moose ]  ; moose is its own plural, so we use \"a-moose\" as the singular.\nbreed [ wolves wolf ]\nturtles-own [ energy ]       ; both wolves and moose have energy\npatches-own [ countdown ]\n\nto setup\n  clear-all\n  set max-moose 1000\n\tset max-wolves 1000\n  ask patches [ set pcolor green ]\n\n  create-moose 3  ; create the moose, then initialize their variables\n  [\n    set shape \"moose\" ; moose shape not in default library anymore?\n    set color brown\n    set size 5\n    setxy random-xcor random-ycor\n  ]\n\n  create-wolves 1  ; create the wolves, then initialize their variables\n  [\n    set shape \"wolf\"\n    set color black\n    set size 5\n    setxy random-xcor random-ycor\n  ]\n  reset-ticks\nend\n\n\nto go\n  if not any? turtles [ stop ]\n\n  if count moose > max-moose [ user-message \"The moose have inherited the earth\" stop ]\n  if count wolves > max-wolves [ user-message \"The wolves have inherited the earth\" stop ]\n\n  ask moose [ moose-actions ]\n\n  ask wolves [\n    wolf-actions\n    let prey one-of moose in-radius 2\n    if prey != nobody [\n    wolf-meets-moose\n    ]\n  ]\n  tick\nend\n\nto flee\n  ifelse count wolves in-radius 5 > 0 [ set heading towards one-of wolves in-radius 5\n    rt (175 + random 10)\n  ][\n    rt random 50\n    lt random 50\n  ]\n  fd 1\nend\n\nto chase\n  ifelse count moose in-radius 5 > 0 [ set heading towards one-of moose in-radius 5\n    rt (random 5 - 10)\n  ][\n    rt random 50\n    lt random 50\n  ]\n  fd 1\nend\n; --- NETTANGO BEGIN ---\n\n; This block of code was added by the NetTango Web Builder.  If you modify this code\n; and re-import it into the NetTango Web Builder you may lose your changes or need\n; to resolve some errors manually.\n\n; If you do not plan to re-import the model into the NetTango Web Builder then you\n; can safely edit this code however you want, just like a normal NetLogo model.\n\n; Code for Wolves\nto wolf-actions\nend\n\nto wolf-meets-moose\nend\n\n; Code for Moose\nto moose-actions\nend\n; --- NETTANGO END ---]]></code>\n  <widgets>\n    <view x=\"355\" wrappingAllowedX=\"true\" y=\"10\" frameRate=\"30\" minPycor=\"-10\" height=\"323\" showTickCounter=\"true\" patchSize=\"14.95\" fontSize=\"10\" wrappingAllowedY=\"true\" width=\"501\" tickCounterLabel=\"ticks\" maxPycor=\"10\" updateMode=\"0\" maxPxcor=\"16\" minPxcor=\"-16\"/>\n    <button x=\"120\" y=\"10\" height=\"40\" disableUntilTicks=\"false\" forever=\"true\" kind=\"Observer\" width=\"95\" display=\"▶\">go</button>\n    <button x=\"5\" y=\"55\" height=\"40\" disableUntilTicks=\"false\" forever=\"true\" kind=\"Observer\" width=\"150\" display=\"▶ in slow motion\">go wait 0.5</button>\n    <plot x=\"5\" autoPlotX=\"true\" yMax=\"10\" autoPlotY=\"true\" y=\"100\" xMin=\"0\" height=\"235\" legend=\"false\" xMax=\"10\" yMin=\"0\" width=\"340\" display=\"wolves and moose\">\n      <setup/>\n      <update/>\n      <pen interval=\"1\" mode=\"0\" display=\"wolves\" color=\"-16777216\" legend=\"true\">\n        <setup/>\n        <update>plot count wolves</update>\n      </pen>\n      <pen interval=\"1\" mode=\"0\" display=\"moose\" color=\"-10022847\" legend=\"true\">\n        <setup/>\n        <update>plot count moose</update>\n      </pen>\n    </plot>\n    <button x=\"5\" y=\"10\" height=\"40\" disableUntilTicks=\"false\" forever=\"false\" kind=\"Observer\" width=\"110\">setup</button>\n  </widgets>\n  <info>## WHAT IS IT?\n\n(a general understanding of what the model is trying to show or explain)\n\n## HOW IT WORKS\n\n(what rules the agents use to create the overall behavior of the model)\n\n## HOW TO USE IT\n\n(how to use the model, including a description of each of the items in the Interface tab)\n\n## THINGS TO NOTICE\n\n(suggested things for the user to notice while running the model)\n\n## THINGS TO TRY\n\n(suggested things for the user to try to do (move sliders, switches, etc.) with the model)\n\n## EXTENDING THE MODEL\n\n(suggested things to add or change in the Code tab to make the model more complicated, detailed, accurate, etc.)\n\n## NETLOGO FEATURES\n\n(interesting or unusual features of NetLogo that the model uses, particularly in the Code tab; or where workarounds were needed for missing features)\n\n## RELATED MODELS\n\n(models in the NetLogo Models Library and elsewhere which are of related interest)\n\n## CREDITS AND REFERENCES\n\n(a reference to the model's URL on the web if it has one, as well as any other necessary credits, citations, and links)</info>\n  <turtleShapes>\n    <shape name=\"default\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"5\"/>\n        <point x=\"40\" y=\"250\"/>\n        <point x=\"150\" y=\"205\"/>\n        <point x=\"260\" y=\"250\"/>\n      </polygon>\n    </shape>\n    <shape name=\"airplane\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"0\"/>\n        <point x=\"135\" y=\"15\"/>\n        <point x=\"120\" y=\"60\"/>\n        <point x=\"120\" y=\"105\"/>\n        <point x=\"15\" y=\"165\"/>\n        <point x=\"15\" y=\"195\"/>\n        <point x=\"120\" y=\"180\"/>\n        <point x=\"135\" y=\"240\"/>\n        <point x=\"105\" y=\"270\"/>\n        <point x=\"120\" y=\"285\"/>\n        <point x=\"150\" y=\"270\"/>\n        <point x=\"180\" y=\"285\"/>\n        <point x=\"210\" y=\"270\"/>\n        <point x=\"165\" y=\"240\"/>\n        <point x=\"180\" y=\"180\"/>\n        <point x=\"285\" y=\"195\"/>\n        <point x=\"285\" y=\"165\"/>\n        <point x=\"180\" y=\"105\"/>\n        <point x=\"180\" y=\"60\"/>\n        <point x=\"165\" y=\"15\"/>\n      </polygon>\n    </shape>\n    <shape name=\"arrow\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"0\"/>\n        <point x=\"0\" y=\"150\"/>\n        <point x=\"105\" y=\"150\"/>\n        <point x=\"105\" y=\"293\"/>\n        <point x=\"195\" y=\"293\"/>\n        <point x=\"195\" y=\"150\"/>\n        <point x=\"300\" y=\"150\"/>\n      </polygon>\n    </shape>\n    <shape name=\"box\" rotatable=\"false\" editableColorIndex=\"0\">\n      <polygon color