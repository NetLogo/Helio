olor {P0}    \n]","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#9437ff","textColor":"#ffffff","borderColor":"#212121","font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[{"name":"X Coordinate","unit":null,"step":1,"random":false,"default":10,"type":"range","min":-30,"max":30},{"name":"Y Coordinate","unit":null,"step":1,"random":false,"default":10,"type":"range","min":-30,"max":30}],"properties":[{"name":"Color","unit":null,"type":"select","default":"Cyan","quoteValues":"never-quote","values":[{"actual":"Cyan","display":"Cyan"},{"actual":"Sky","display":"Sky"},{"actual":"Blue","display":"Blue"},{"actual":"Red","display":"Red"},{"actual":"Yellow","display":"Yellow"}]}],"fontWeight":400,"fontSize":12,"fontFace":"'Poppins', sans-serif","start":false,"control":false}],"menuConfig":{"mainGroup":{"isCollapsed":false,"order":[0,2,4,3]},"tagGroups":[]},"program":{"chains":[{"x":37,"y":40,"blocks":[{"definitionId":0,"instanceId":0,"clauses":[],"params":[],"properties":[],"propertiesDisplay":"shown"},{"definitionId":2,"instanceId":0,"clauses":[],"params":[{"type":"range","value":5}],"properties":[],"propertiesDisplay":"shown"},{"definitionId":4,"instanceId":0,"clauses":[],"params":[{"type":"range","value":125}],"properties":[],"propertiesDisplay":"shown"},{"definitionId":3,"instanceId":0,"clauses":[],"params":[{"type":"range","value":20},{"type":"range","value":0}],"properties":[{"type":"select","value":"Blue"}],"propertiesDisplay":"shown"},{"definitionId":3,"instanceId":1,"clauses":[],"params":[{"type":"range","value":-25},{"type":"range","value":30}],"properties":[{"type":"select","value":"Yellow"}],"propertiesDisplay":"shown"},{"definitionId":3,"instanceId":2,"clauses":[],"params":[{"type":"range","value":-20},{"type":"range","value":-20}],"properties":[{"type":"select","value":"Red"}],"propertiesDisplay":"shown"}]}]},"chainOpen":null,"chainClose":"end","variables":[],"expressions":[{"name":"true","type":"bool","arguments":[],"format":null},{"name":"false","type":"bool","arguments":[],"format":null},{"name":"AND","type":"bool","arguments":["bool","bool"],"format":"({0} and {1})"},{"name":"OR","type":"bool","arguments":["bool","bool"],"format":"({0} or {1})"},{"name":"NOT","type":"bool","arguments":["bool"],"format":"(not {0})"},{"name":">","type":"bool","arguments":["num","num"],"format":null},{"name":">=","type":"bool","arguments":["num","num"],"format":null},{"name":"<","type":"bool","arguments":["num","num"],"format":null},{"name":"<=","type":"bool","arguments":["num","num"],"format":null},{"name":"!=","type":"bool","arguments":["num","num"],"format":null},{"name":"=","type":"bool","arguments":["num","num"],"format":null},{"name":"+","type":"num","arguments":["num","num"],"format":null},{"name":"-","type":"num","arguments":["num","num"],"format":null},{"name":"×","type":"num","arguments":["num","num"],"format":"({0} * {1})"},{"name":"/","type":"num","arguments":["num","num"],"format":null},{"name":"random","type":"num","arguments":["num"],"format":"random-float {0}"}]},"netLogoCode":"to do-setup\n  ask patches [        \n   set nest? (distancexy 0 0) < 5        \n   if nest? [set pcolor violet]\n   set nest-scent 200 - distancexy 0 0 \n  ]\n  create-turtles 125\n  ask patches with [distancexy 20 0 < 5] [          \n     set food one-of [1 2]         \n     set pcolor Blue    \n  ]\n  ask patches with [distancexy -25 30 < 5] [          \n     set food one-of [1 2]         \n     set pcolor Yellow    \n  ]\n  ask patches with [distancexy -20 -20 < 5] [          \n     set food one-of [1 2]         \n     set pcolor Red    \n  ]\nend","netLogoDisplay":"to do-setup\n  ask patches [        \n   set nest? (distancexy 0 0) < 5        \n   if nest? [set pcolor violet]\n   set nest-scent 200 - distancexy 0 0 \n  ]\n  create-turtles 125\n  ask patches with [distancexy 20 0 < 5] [          \n     set food one-of [1 2]         \n     set pcolor Blue    \n  ]\n  as