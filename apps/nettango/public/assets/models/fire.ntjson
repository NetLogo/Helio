{"spaces":[{"id":0,"spaceId":"ntb-defs-0","name":"Program a Forest Fire","width":600,"height":550,"defs":{"version":7,"height":550,"width":600,"blocks":[{"id":0,"action":"setup","isRequired":true,"placement":"starter","type":null,"format":"to setup-nettango","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":1,"note":null,"blockColor":null,"textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[]},{"id":1,"action":"set 🌳 🌳  density","isRequired":false,"placement":"child","type":null,"format":"set density {0}","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#58b03c","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[{"name":"Parameter 0","unit":"%","step":1,"random":false,"default":50,"type":"int","def":50,"value":50}],"properties":[]},{"id":2,"action":"chance 🔥 spreads","isRequired":false,"placement":"child","type":null,"format":"set probability-of-spread {0}","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#ff7f00","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[{"name":"Parameter 0","unit":"%","step":1,"random":false,"default":100,"type":"int","value":100}],"properties":[]},{"id":3,"action":"go","isRequired":true,"placement":"starter","type":null,"format":"to go-nettango","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":1,"note":null,"blockColor":null,"textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[]},{"id":8,"action":"ask 🔥🔥","isRequired":false,"placement":"child","type":null,"format":"  ask patches with [ pcolor = red ]","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#ff7f00","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[{"action":null,"open":"[","close":"]","allowedTags":{"type":"unrestricted"}}],"params":[],"properties":[]},{"id":9,"action":"ask neighboring 🌳 🌳 ","isRequired":false,"placement":"child","type":null,"format":"ask neighbors4 with [ pcolor = green ]","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#58b03c","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[{"action":null,"open":"[","close":"]","allowedTags":{"type":"unrestricted"}}],"params":[],"properties":[]},{"id":15,"action":"ask neighboring 🔥🔥 ","isRequired":false,"placement":"child","type":null,"format":"ask neighbors4 with [ pcolor = red ]","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#ff7c3c","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[{"action":null,"open":"[","close":"]","allowedTags":{"type":"unrestricted"}}],"params":[],"properties":[]},{"id":6,"action":"catch 🔥","isRequired":false,"placement":"child","type":null,"format":"if any? neighbors with [pcolor = red][if random 100 < probability-of-spread [ set pcolor red ]]","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#ff7f00","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[]},{"id":10,"action":"cool 🔥🔥","isRequired":false,"placement":"child","type":null,"format":"set pcolor red - 3.5","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":"once the tree is burned, darken its color","blockColor":"#ff7c00","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[]},{"id":14,"action":"ask  🌳 🌳 ","isRequired":false,"placement":"child","type":null,"format":"ask patches with [pcolor = green]","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":null,"blockColor":"#58b03c","textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[{"action":null,"open":"[","close":"]","allowedTags":{"type":"unrestricted"}}],"params":[],"properties":[]},{"id":13,"action":"Fighting 🔥🔥","isRequired":true,"placement":"starter","type":null,"format":"to firefight","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":1,"note":null,"blockColor":null,"textColor":null,"borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[]},{"id":12,"action":"Make a fire break line","isRequired":false,"placement":"child","type":null,"format":"ask patches with [pxcor = {P0} and pycor > {P1}] [set pcolor black set cost cost + 100]","isTerminal":false,"closeClauses":null,"closeStarter":null,"limit":0,"note":"Using this block you can cut a fire break. Each patch you clear costs $100.","blockColor":"#ffffff","textColor":"#171717","borderColor":null,"font":null,"allowedTags":{"type":"unrestricted"},"tags":[],"clauses":[],"params":[],"properties":[{"name":"fire break line x =","unit":null,"step":1,"random":false,"default":4,"type":"int","value":4},{"name":"fire break line  y < ","unit":null,"step":1,"random":false,"default":-100,"type":"int","value":-100}]}],"menuConfig":{"mainGroup":{"isCollapsed":false,"order":[0,1,2,3,8,9,15,6,10,14,13,12]},"tagGroups":[]},"program":{"chains":[{"x":84.26953125,"y":21.5595703125,"blocks":[{"definitionId":0,"instanceId":0,"clauses":[],"params":[],"properties":[],"propertiesDisplay":"shown"},{"definitionId":1,"instanceId":0,"clauses":[],"params":[{"type":"int","value":56}],"properties":[],"propertiesDisplay":"shown"},{"definitionId":2,"instanceId":0,"clauses":[],"params":[{"type":"int","value":100}],"properties":[],"propertiesDisplay":"shown"}]},{"x":87.2900390625,"y":183.7265625,"blocks":[{"definitionId":3,"instanceId":0,"clauses":[],"params":[],"properties":[],"propertiesDisplay":"shown"}]}]},"chainOpen":null,"chainClose":"end","variables":[],"expressions":[{"name":"true","type":"bool","arguments":[],"format":null},{"name":"false","type":"bool","arguments":[],"format":null},{"name":"AND","type":"bool","arguments":["bool","bool"],"format":"({0} and {1})"},{"name":"OR","type":"bool","arguments":["bool","bool"],"format":"({0} or {1})"},{"name":"NOT","type":"bool","arguments":["bool"],"format":"(not {0})"},{"name":">","type":"bool","arguments":["num","num"],"format":null},{"name":">=","type":"bool","arguments":["num","num"],"format":null},{"name":"<","type":"bool","arguments":["num","num"],"format":null},{"name":"<=","type":"bool","arguments":["num","num"],"format":null},{"name":"!=","type":"bool","arguments":["num","num"],"format":null},{"name":"=","type":"bool","arguments":["num","num"],"format":null},{"name":"+","type":"num","arguments":["num","num"],"format":null},{"name":"-","type":"num","arguments":["num","num"],"format":null},{"name":"×","type":"num","arguments":["num","num"],"format":"({0} * {1})"},{"name":"/","type":"num","arguments":["num","num"],"format":null},{"name":"random","type":"num","arguments":["num"],"format":"random-float {0}"}]},"netLogoCode":"to go-nettango\nend\n\nto setup-nettango\n  set density 56\n  set probability-of-spread 100\nend\n\nto firefight\nend","netLogoDisplay":"to go-nettango\nend\n\nto setup-nettango\n  set density 56\n  set probability-of-spread 100\nend\n\nto firefight\nend"}],"netTangoOptions":{"workspaceBelow":false,"showCode":true,"enablePlayModeDefinitionChanges":false,"enableCodeTips":true},"netLogoOptions":{"commandCenterTab":true,"codeTab":true,"infoTab":true,"inspectionTab":true,"speedBar":true,"fileButtons":false,"authoring":true,"poweredBy":true},"blockStyles":{"starterBlockStyle":{"blockColor":"#bb5555","textColor":"#ffffff","borderColor":"#ffffff","fontWeight":"","fontSize":"","fontFace":""},"containerBlockStyle":{"blockColor":"#8899aa","textColor":"#ffffff","borderColor":"#ffffff","fontWeight":"","fontSize":"","fontFace":""},"commandBlockStyle":{"blockColor":"#9977aa","textColor":"#ffffff","borderColor":"#ffffff","fontWeight":"","fontSize":"","fontFace":""}},"title":"Fire Fighting","extraCss":"","code":"<?xml version=\"1.0\" encoding=\"utf-8\"?><model version=\"NetLogo 7.0.4\" snapToGrid=\"false\" nlw-version=\"2.16.0\">\n  <code><![CDATA[globals [\n  initial-trees   ;; how many trees (green patches) we started with\n  density\n  probability-of-spread\n  cost\n]\n\nto setup\n  clear-all\n  set probability-of-spread 100\n  set density 37\n  setup-nettango\n  ;; make some green trees\n  ask patches [\n    if (random 100) < density\n    [ set pcolor green ]\n    ;; make a column of burning trees at the left-edge\n    if pxcor = min-pxcor\n    [ set pcolor red ]\n  ]\n  firefight\n\n  ;; keep track of how many trees there are\n  set initial-trees count patches with [pcolor = green]\n  reset-ticks\nend\n\nto go\n  ;; stop the model when done\n  ;if all? patches [ pcolor != red ] [ stop ]\n  go-nettango\n\n\n  ;; ask the burning trees to set fire to any neighboring non-burning trees\n\n  tick ;; advance the clock by one “tick”\nend\n\nto draw\n\n\n        if mouse-down?\n        [\n\n            ask patch mouse-xcor mouse-ycor\n            [\n              set pcolor black set cost cost + 100\n              ask neighbors [set pcolor black set cost cost + 100]\n            ]\n\n        ]\n\n\n  end\n\n\n; Copyright 2021 Kit Martin.\n; See Info tab for full copyright and license.\n; --- NETTANGO BEGIN ---\n\n; This block of code was added by the NetTango Web Builder.  If you modify this code\n; and re-import it into the NetTango Web Builder you may lose your changes or need\n; to resolve some errors manually.\n\n; If you do not plan to re-import the model into the NetTango Web Builder then you\n; can safely edit this code however you want, just like a normal NetLogo model.\n\nto go-nettango\nend\n\nto setup-nettango\n  set density 56\n  set probability-of-spread 100\nend\n\nto firefight\nend\n; --- NETTANGO END ---]]></code>\n  <widgets>\n    <view x=\"260\" wrappingAllowedX=\"false\" y=\"10\" frameRate=\"30\" minPycor=\"-125\" height=\"511\" showTickCounter=\"true\" patchSize=\"2\" fontSize=\"10\" wrappingAllowedY=\"false\" width=\"510\" tickCounterLabel=\"ticks\" maxPycor=\"125\" updateMode=\"1\" maxPxcor=\"125\" minPxcor=\"-125\"/>\n    <monitor x=\"5\" precision=\"1\" y=\"55\" height=\"60\" fontSize=\"11\" width=\"115\" display=\"percent 🔥 burned\">((count patches with [shade-of? pcolor red]) / initial-trees)\n* 100</monitor>\n    <button x=\"105\" y=\"10\" height=\"40\" disableUntilTicks=\"true\" forever=\"true\" kind=\"Observer\" width=\"95\" display=\"go\">draw go</button>\n    <button x=\"5\" y=\"10\" height=\"40\" disableUntilTicks=\"false\" forever=\"false\" kind=\"Observer\" width=\"95\" display=\"setup\">setup-nettango setup</button>\n    <monitor x=\"125\" precision=\"0\" y=\"55\" height=\"60\" fontSize=\"11\" width=\"125\" display=\"Cost of 🔥 Fighting\">cost</monitor>\n  </widgets>\n  <info><![CDATA[## WHAT IS IT?\n\nThis project simulates the spread of a fire through a forest.  It shows that the fire's chance of reaching the right edge of the forest depends critically on the density of trees. This is an example of a common feature of complex systems, the presence of a non-linear threshold or critical parameter. This model extends the Fire Simple model by adding fire fighting ability.\n\n## HOW IT WORKS\n\nThe fire starts on the left edge of the forest, and spreads to neighboring trees. The fire spreads in four directions: north, east, south, and west.\n\nUnlike the original model, this model allows the user to fight the fire. They can either click on the screen to cut down trees, or use the fighting fires procedure to place fire breaks. There also is a \"cost\" monitor that shows how much the attempts to contain the fire have cost.  As a result, the spread of the fire is determined by the rules of the fire, and the users attempts to stop the fire..\n\n## HOW TO USE IT\n\nClick the SETUP button to set up the trees (green) and fire (red on the left-hand side).\n\nClick the GO button to start the simulation. \n\nThe DENSITY block under the setup procedure controls the density of trees in the forest. (Note: Changes in the DENSITY under setup do not take effect until the next SETUP.)\n\nThe PROBABILITY-OF-SPREAD block affects how the fire spreads from patch to patch. This simulates such affects as wind or the type of wood.\n\n## THINGS TO NOTICE\n\nCompare this model to the FIRE-SIMPLE model.  When the PROBABILITY-OF-SPREAD is low, how are the results different?  When the PROBABILITY-OF-SPREAD is high how are the results different?\n\n## THINGS TO TRY\n\n\nWhat is the difference between 100% density and 55% probability-of-spread, and 55% density and 100% probability-of-spread? Why do those yield so different results?\n\nWhere is the most effective place to put a fire break?\n\nHow high can you put the \"DENSITY\" and still contain the fire?\n\n## RELATED MODELS\n\nFire Simple, Fire, Percolation, Rumor Mill\n\n## CREDITS AND REFERENCES\n\nThis model is a NetTango version of:\n\n* Wilensky, U. (1997).  NetLogo Fire model.  http://ccl.northwestern.edu/netlogo/models/Fire.  Center for Connected Learning and Computer-Based Modeling, Northwestern University, Evanston, IL.\n\n## HOW TO CITE\n\n\nIf you mention this model or the NetLogo software in a publication, we ask that you include the citations below.\n\nFor the model itself:\n\n* Martin, K. (2021).  NetTango Fire Fighting.  http://ccl.northwestern.edu/theorybuilding/Fire.html.  Center for Connected Learning and Computer-Based Modeling, Northwestern Institute on Complex Systems, Northwestern University, Evanston, IL.\n\nPlease cite the NetLogo software as:\n\n* Wilensky, U. (1999). NetLogo. http://ccl.northwestern.edu/netlogo/. Center for Connected Learning and Computer-Based Modeling, Northwestern University, Evanston, IL.\n\n\n## COPYRIGHT AND LICENSE\n\nCopyright 2006 Uri Wilensky.\n\n![CC BY-NC-SA 3.0](http://ccl.northwestern.edu/images/creativecommons/byncsa.png)\n\nThis work is licensed under the Creative Commons Attribution-NonCommercial-ShareAlike 3.0 License.  To view a copy of this license, visit https://creativecommons.org/licenses/by-nc-sa/3.0/ or send a letter to Creative Commons, 559 Nathan Abbott Way, Stanford, California 94305, USA.\n\nCommercial licenses are also available. To inquire about commercial licenses, please contact Uri Wilensky at uri@northwestern.edu.\n\n<!-- 2021 -->]]></info>\n  <turtleShapes>\n    <shape name=\"default\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"5\"/>\n        <point x=\"40\" y=\"250\"/>\n        <point x=\"150\" y=\"205\"/>\n        <point x=\"260\" y=\"250\"/>\n      </polygon>\n    </shape>\n    <shape name=\"airplane\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"0\"/>\n        <point x=\"135\" y=\"15\"/>\n        <point x=\"120\" y=\"60\"/>\n        <point x=\"120\" y=\"105\"/>\n        <point x=\"15\" y=\"165\"/>\n        <point x=\"15\" y=\"195\"/>\n        <point x=\"120\" y=\"180\"/>\n        <point x=\"135\" y=\"240\"/>\n        <point x=\"105\" y=\"270\"/>\n        <point x=\"120\" y=\"285\"/>\n        <point x=\"150\" y=\"270\"/>\n        <point x=\"180\" y=\"285\"/>\n        <point x=\"210\" y=\"270\"/>\n        <point x=\"165\" y=\"240\"/>\n        <point x=\"180\" y=\"180\"/>\n        <point x=\"285\" y=\"195\"/>\n        <point x=\"285\" y=\"165\"/>\n        <point x=\"180\" y=\"105\"/>\n        <point x=\"180\" y=\"60\"/>\n        <point x=\"165\" y=\"15\"/>\n      </polygon>\n    </shape>\n    <shape name=\"arrow\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"0\"/>\n        <point x=\"0\" y=\"150\"/>\n        <point x=\"105\" y=\"150\"/>\n        <point x=\"105\" y=\"293\"/>\n        <point x=\"195\" y=\"293\"/>\n        <point x=\"195\" y=\"150\"/>\n        <point x=\"300\" y=\"150\"/>\n      </polygon>\n    </shape>\n    <shape name=\"box\" rotatable=\"false\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"285\"/>\n        <point x=\"285\" y=\"225\"/>\n        <point x=\"285\" y=\"75\"/>\n        <point x=\"150\" y=\"135\"/>\n      </polygon>\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"135\"/>\n        <point x=\"15\" y=\"75\"/>\n        <point x=\"150\" y=\"15\"/>\n        <point x=\"285\" y=\"75\"/>\n      </polygon>\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"15\" y=\"75\"/>\n        <point x=\"15\" y=\"225\"/>\n        <point x=\"150\" y=\"285\"/>\n        <point x=\"150\" y=\"135\"/>\n      </polygon>\n      <line endX=\"150\" startY=\"285\" marked=\"false\" color=\"255\" endY=\"135\" startX=\"150\"/>\n      <line endX=\"15\" startY=\"135\" marked=\"false\" color=\"255\" endY=\"75\" startX=\"150\"/>\n      <line endX=\"285\" startY=\"135\" marked=\"false\" color=\"255\" endY=\"75\" startX=\"150\"/>\n    </shape>\n    <shape name=\"bug\" rotatable=\"true\" editableColorIndex=\"0\">\n      <circle x=\"96\" y=\"182\" marked=\"true\" color=\"-1920102913\" diameter=\"108\" filled=\"true\"/>\n      <circle x=\"110\" y=\"127\" marked=\"true\" color=\"-1920102913\" diameter=\"80\" filled=\"true\"/>\n      <circle x=\"110\" y=\"75\" marked=\"true\" color=\"-1920102913\" diameter=\"80\" filled=\"true\"/>\n      <line endX=\"80\" startY=\"100\" marked=\"true\" color=\"-1920102913\" endY=\"30\" startX=\"150\"/>\n      <line endX=\"220\" startY=\"100\" marked=\"true\" color=\"-1920102913\" endY=\"30\" startX=\"150\"/>\n    </shape>\n    <shape name=\"butterfly\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"165\"/>\n        <point x=\"209\" y=\"199\"/>\n        <point x=\"225\" y=\"225\"/>\n        <point x=\"225\" y=\"255\"/>\n        <point x=\"195\" y=\"270\"/>\n        <point x=\"165\" y=\"255\"/>\n        <point x=\"150\" y=\"240\"/>\n      </polygon>\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"165\"/>\n        <point x=\"89\" y=\"198\"/>\n        <point x=\"75\" y=\"225\"/>\n        <point x=\"75\" y=\"255\"/>\n        <point x=\"105\" y=\"270\"/>\n        <point x=\"135\" y=\"255\"/>\n        <point x=\"150\" y=\"240\"/>\n      </polygon>\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"139\" y=\"148\"/>\n        <point x=\"100\" y=\"105\"/>\n        <point x=\"55\" y=\"90\"/>\n        <point x=\"25\" y=\"90\"/>\n        <point x=\"10\" y=\"105\"/>\n        <point x=\"10\" y=\"135\"/>\n        <point x=\"25\" y=\"180\"/>\n        <point x=\"40\" y=\"195\"/>\n        <point x=\"85\" y=\"194\"/>\n        <point x=\"139\" y=\"163\"/>\n      </polygon>\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"162\" y=\"150\"/>\n        <point x=\"200\" y=\"105\"/>\n        <point x=\"245\" y=\"90\"/>\n        <point x=\"275\" y=\"90\"/>\n        <point x=\"290\" y=\"105\"/>\n        <point x=\"290\" y=\"135\"/>\n        <point x=\"275\" y=\"180\"/>\n        <point x=\"260\" y=\"195\"/>\n        <point x=\"215\" y=\"195\"/>\n        <point x=\"162\" y=\"165\"/>\n      </polygon>\n      <polygon color=\"255\" filled=\"true\" marked=\"false\">\n        <point x=\"150\" y=\"255\"/>\n        <point x=\"135\" y=\"225\"/>\n  