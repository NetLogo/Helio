:"random","type":"num","arguments":["num"],"format":"random-float {0}"}]},"netLogoCode":"to go\n  ask healthies\n  [\n     move \n  ]\n  ask sicks\n  [\n    infect\n    if random 100 < 0.91\n    [\n      set infected? false \n      set color green + 1\n      set breed healthies\n      set shape \"person\"\n      set num-infected num-infected - 1\n      set immunity? \"true\"\n    ]\n    if random 100 < 0.20\n    [\n      set immunity? \"false\"\n    ]\n  ]\n  tick\nend\n\nto setup\n  create-sick-people 6\n  create-healthy-people 500\n  set infectiousness 21.96\n  ask healthies\n  [\n    set immunity? \"false\"\n  ]\n  ask sicks\n  [\n    set mask-strength 20\n    set gloves-strength 0\n    set face-tocuhing 0\n  ]\nend","netLogoDisplay":"to go\n  ask healthies\n  [\n     move \n  ]\n  ask sicks\n  [\n    infect\n    if random 100 < 0.91\n    [\n      set infected? false \n      set color green + 1\n      set breed healthies\n      set shape \"person\"\n      set num-infected num-infected - 1\n      set immunity? \"true\"\n    ]\n    if random 100 < 0.20\n    [\n      set immunity? \"false\"\n    ]\n  ]\n  tick\nend\n\nto setup\n  create-sick-people 6\n  create-healthy-people 500\n  set infectiousness 21.96\n  ask healthies\n  [\n    set immunity? \"false\"\n  ]\n  ask sicks\n  [\n    set mask-strength 20\n    set gloves-strength 0\n    set face-tocuhing 0\n  ]\nend"}],"netTangoOptions":{"workspaceBelow":false,"showCode":true,"enablePlayModeDefinitionChanges":false,"enableCodeTips":true},"netLogoOptions":{"commandCenterTab":true,"codeTab":true,"infoTab":false,"inspectionTab":true,"speedBar":false,"fileButtons":true,"authoring":true,"poweredBy":true},"blockStyles":{"starterBlockStyle":{"blockColor":"#bb5555","textColor":"#ffffff","borderColor":"#ffffff","fontWeight":"","fontSize":"","fontFace":""},"containerBlockStyle":{"blockColor":"#8899aa","textColor":"#ffffff","borderColor":"#ffffff","fontWeight":"","fontSize":"","fontFace":""},"commandBlockStyle":{"blockColor":"#9977aa","textColor":"#ffffff","borderColor":"#ffffff","fontWeight":"","fontSize":"","fontFace":""}},"title":"Disease","extraCss":"/* test of extraCss load */","code":"<?xml version=\"1.0\" encoding=\"utf-8\"?><model version=\"NetLogo 7.0.4\" snapToGrid=\"false\" nlw-version=\"2.16.0\">\n  <code><![CDATA[breed [healthies healthy]\nbreed [sicks sick ]\nbreed [germs germ]\n\nglobals [num-infected number infectiousness nature-infects-number]\nturtles-own [infected?]\npatches-own [contaminated?]\nhealthies-own [immunity? immune-system-strength mask-strength gloves-strength face-tocuhing]\nsicks-own [immunity? immune-system-strength mask-strength gloves-strength face-tocuhing ]\n\nto setup1\n  ca\n  set number 500\n  \n  ;ask one-of turtles [set infected? true set color red]\n  ;set num-infected 1\n  setup\n  reset-ticks\nend\n\n  to experiment1\n  if num-infected >= 500 [stop]\n  ask turtles [\n  move\n    if infected? [infect]\n  ]\n  tick\nend\n\nto create-healthy-people [num]\n  create-healthies num [set shape \"person\" setxy random-xcor random-ycor set color green set infected? false]\nend\n\nto create-sick-people [num]\n  create-sicks num [set shape \"person\" setxy random-xcor random-ycor set color red set infected? true]\nend\n\nto infect\n\n  let infected-here turtles-here with [not infected?]\n  if any?  infected-here [\n    if random-float 100 < infectiousness [\n      ask one-of infected-here\n      [\n        basic-infect\n      ]\n      ]\n  ]\n    end\n\nto basic-infect\n    if immunity? != true \n    [\n            set infected? true \n            set breed sicks\n            set shape \"person\"\n            set color red \n            set num-infected num-infected + 1\n    ]\nend\n\n\nto infect-from-surface\n\nask one-of healthies-here \n  [\n        basic-infect\n  ]\nend\n\nto move\n  rt random 30 lt random 30 fd 1\nend\n\nto nature-infects [ num ]\n  if not any? turtles with [not infected?] [stop]\n  if nature-infects-number < count healthies [\n  ask n-of num turtles with [not infected?] [\n        basic-infect\n    ]\n  ]\n    tick\nend\n\nto emitvirus [ emission siz distancesneeze ]\n  hatch-germs emission [ set size siz fd distancesneeze ]\nend\n\nto contaminate-surface\n  ifelse count germs-here > 1 [ set contaminated? true ] [set pcolor black set contaminated? false] if contaminated? = true [set pcolor red - 3 ]\n  end\n; --- NETTANGO BEGIN ---\n\n; This block of code was added by the NetTango Web Builder.  If you modify this code\n; and re-import it into the NetTango Web Builder you may lose your changes or need\n; to resolve some errors manually.\n\n; If you do not plan to re-import the model into the NetTango Web Builder then you\n; can safely edit this code however you want, just like a normal NetLogo model.\n\nto go\n  ask healthies\n  [\n     move \n  ]\n  ask sicks\n  [\n    infect\n    if random 100 < 0.91\n    [\n      set infected? false \n      set color green + 1\n      set breed healthies\n      set shape \"person\"\n      set num-infected num-infected - 1\n      set immunity? \"true\"\n    ]\n    if random 100 < 0.20\n    [\n      set immunity? \"false\"\n    ]\n  ]\n  tick\nend\n\nto setup\n  create-sick-people 6\n  create-healthy-people 500\n  set infectiousness 21.96\n  ask healthies\n  [\n    set immunity? \"false\"\n  ]\n  ask sicks\n  [\n    set mask-strength 20\n    set gloves-strength 0\n    set face-tocuhing 0\n  ]\nend\n; --- NETTANGO END ---]]></code>\n  <widgets>\n    <view x=\"355\" wrappingAllowedX=\"true\" y=\"10\" frameRate=\"30\" minPycor=\"-16\" height=\"438\" showTickCounter=\"true\" patchSize=\"13\" fontSize=\"10\" wrappingAllowedY=\"true\" width=\"437\" tickCounterLabel=\"days\" maxPycor=\"16\" updateMode=\"1\" maxPxcor=\"16\" minPxcor=\"-16\"/>\n    <button x=\"5\" y=\"10\" height=\"40\" disableUntilTicks=\"false\" forever=\"false\" kind=\"Observer\" width=\"95\" display=\"setup\">setup1</button>\n    <plot x=\"5\" autoPlotX=\"true\" yMax=\"10\" autoPlotY=\"true\" yAxis=\"num infected\" y=\"120\" xMin=\"0\" height=\"235\" legend=\"false\" xMax=\"10\" yMin=\"0\" width=\"340\" xAxis=\"days\" display=\"num infected\">\n      <setup/>\n      <update/>\n      <pen interval=\"1\" mode=\"0\" display=\"default\" color=\"-2674135\" legend=\"true\">\n        <setup/>\n        <update>plot count turtles with [infected?]</update>\n      </pen>\n    </plot>\n    <button x=\"105\" y=\"10\" height=\"40\" disableUntilTicks=\"false\" forever=\"true\" kind=\"Observer\" width=\"95\">go</button>\n    <monitor x=\"5\" precision=\"0\" y=\"55\" height=\"60\" fontSize=\"11\" width=\"100\" display=\"susceptible\">count healthies with [ immunity? = false ]</monitor>\n    <monitor x=\"110\" precision=\"0\" y=\"55\" height=\"60\" fontSize=\"11\" width=\"100\" display=\"infected\">count sicks</monitor>\n    <monitor x=\"215\" precision=\"0\" y=\"55\" height=\"60\" fontSize=\"11\" width=\"100\" display=\"recovered\">count healthies with [color = green + 1]</monitor>\n  </widgets>\n  <info>## WHAT IS IT?\n\n(a general understanding of what the model is trying to show or explain)\n\n## HOW IT WORKS\n\n(what rules the agents use to create the overall behavior of the model)\n\n## HOW TO USE IT\n\n(how to use the model, including a description of each of the items in the Interface tab)\n\n## THINGS TO NOTICE\n\n(suggested things for the user to notice while running the model)\n\n## THINGS TO TRY\n\n(suggested things for the user to try to do (move sliders, switches, etc.) with the model)\n\n## EXTENDING THE MODEL\n\n(suggested things to add or change in the Code tab to make the model more complicated, detailed, accurate, etc.)\n\n## NETLOGO FEATURES\n\n(interesting or unusual features of NetLogo that the model uses, particularly in the Code tab; or where workarounds were needed for missing features)\n\n## RELATED MODELS\n\n(models in the NetLogo Models Library and elsewhere which are of related interest)\n\n## CREDITS AND REFERENCES\n\n(a reference to the model's URL on the web if it has one, as well as any other necessary credits, citations, and links)</info>\n  <turtleShapes>\n    <shape name=\"default\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"5\"/>\n        <point x=\"40\" y=\"250\"/>\n        <point x=\"150\" y=\"205\"/>\n        <point x=\"260\" y=\"250\"/>\n      </polygon>\n    </shape>\n    <shape name=\"airplane\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"0\"/>\n        <point x=\"135\" y=\"15\"/>\n        <point x=\"120\" y=\"60\"/>\n        <point x=\"120\" y=\"105\"/>\n        <point x=\"15\" y=\"165\"/>\n        <point x=\"15\" y=\"195\"/>\n        <point x=\"120\" y=\"180\"/>\n        <point x=\"135\" y=\"240\"/>\n        <point x=\"105\" y=\"270\"/>\n        <point x=\"120\" y=\"285\"/>\n        <point x=\"150\" y=\"270\"/>\n        <point x=\"180\" y=\"285\"/>\n        <point x=\"210\" y=\"270\"/>\n        <point x=\"165\" y=\"240\"/>\n        <point x=\"180\" y=\"180\"/>\n        <point x=\"285\" y=\"195\"/>\n        <point x=\"285\" y=\"165\"/>\n        <point x=\"180\" y=\"105\"/>\n        <point x=\"180\" y=\"60\"/>\n        <point x=\"165\" y=\"15\"/>\n      </polygon>\n    </shape>\n    <shape name=\"arrow\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"0\"/>\n        <point x=\"0\" y=\"150\"/>\n        <point x=\"105\" y=\"150\"/>\n        <point x=\"105\" y=\"293\"/>\n        <point x=\"195\" y=\"293\"/>\n        <point x=\"195\" y=\"150\"/>\n        <point x=\"300\" y=\"150\"/>\n      </polygon>\n    </shape>\n    <shape name=\"box\" rotatable=\"false\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"285\"/>\n        <p