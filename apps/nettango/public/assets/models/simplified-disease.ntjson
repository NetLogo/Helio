max-pycor) ]   ]\nend"}],"netTangoOptions":{"workspaceBelow":false,"showCode":true,"enablePlayModeDefinitionChanges":false,"enableCodeTips":true},"netLogoOptions":{"commandCenterTab":true,"codeTab":true,"infoTab":true,"inspectionTab":true,"speedBar":false,"fileButtons":true,"authoring":true,"poweredBy":true},"blockStyles":{"starterBlockStyle":{"blockColor":"#bb5555","textColor":"#ffffff","borderColor":"#ffffff","fontWeight":"","fontSize":"","fontFace":""},"containerBlockStyle":{"blockColor":"#8899aa","textColor":"#ffffff","borderColor":"#ffffff","fontWeight":"","fontSize":"","fontFace":""},"commandBlockStyle":{"blockColor":"#9977aa","textColor":"#ffffff","borderColor":"#ffffff","fontWeight":"","fontSize":"","fontFace":""}},"title":"Simplified Disease","extraCss":"","code":"<?xml version=\"1.0\" encoding=\"utf-8\"?><model version=\"NetLogo 7.0.4\" snapToGrid=\"false\" nlw-version=\"2.16.0\">\n  <code><![CDATA[breed [sicks sick]\nbreed [wells well]\n\nglobals [population starting infected]\n\nturtles-own \n[\n  candidate\n]\n\nto setup\n  ca\n  reset-ticks\n  set-default-shape sicks \"sick\"\n  set-default-shape wells \"person\"\n;   Create-wells population [setxy (random min-pxcor  - random max-pxcor ) (random min-pycor - random max-pycor) set size 3 set color grey]\n;   create-sicks starting-infected\n;   [\n;     set size 3 set color red\n;     ifelse starting-infected = 1\n;     [set xcor 1]\n;     [setxy (random min-pxcor  - random max-pxcor ) (random min-pycor - random max-pycor) ]\n;   ]\n  color-ground\n  setup2\n\nend\n\nto go\n  ;ask turtles [ move ]\n  ;ask sicks [ infect ]\n  ;ask sicks [if random 100 < reovery-rate [ recover ] ]\n  ask turtles [ go-blocks ]\n  tick\nend\n\nto move\n\n  fd 1\n  right random 90\n  left random 90\n\nend\n\nto infect\n  ask wells-here [ set breed sicks show-illness]\n\nend\n\nto infect-in-radius\n   set breed sicks show-illness\nend\n\nto show-illness\n  ask sicks [ set shape \"sick\" set color red]\n\nend\n\nto recover\n  set breed wells\n  set color grey\n  set shape \"person\"\nend\n\nto color-ground\n  ask patches [if pxcor mod 2 = 0 and pycor mod 2 = 0 [set pcolor grey - 4 ] ]\nend\n\nto-report sick-percentage\n  let return 0.1\n  if ticks > 1 [\n  set return (count sicks / count turtles ) * 100\n ; if count wells > 0 [\n    ;set return (count sicks / count turtles ) * 100 \n  \n  ]\n    report return\nend\n; --- NETTANGO BEGIN ---\n\n; This block of code was added by the NetTango Web Builder.  If you modify this code\n; and re-import it into the NetTango Web Builder you may lose your changes or need\n; to resolve some errors manually.\n\n; If you do not plan to re-import the model into the NetTango Web Builder then you\n; can safely edit this code however you want, just like a normal NetLogo model.\n\nto go-blocks\n  if random 100 < 100 [ move ] \n  ask sicks [  if random 100 < 100 [infect  ] ] \nend\n\nto setup2\n  Create-wells 30 [setxy (random min-pxcor  - random max-pxcor ) (random min-pycor - random max-pycor) set size 3 set color grey]\n  create-sicks 1  [ set size 3 set color red     ifelse 1 = 1     [set xcor 1]     [setxy (random min-pxcor  - random max-pxcor ) (random min-pycor - random max-pycor) ]   ]\nend\n; --- NETTANGO END ---]]></code>\n  <widgets>\n    <view x=\"355\" wrappingAllowedX=\"true\" y=\"10\" frameRate=\"30\" minPycor=\"-16\" height=\"438\" showTickCounter=\"true\" patchSize=\"13\" fontSize=\"10\" wrappingAllowedY=\"true\" width=\"541\" tickCounterLabel=\"ticks\" maxPycor=\"16\" updateMode=\"0\" maxPxcor=\"20\" minPxcor=\"-20\"/>\n    <button x=\"5\" y=\"10\" height=\"40\" disableUntilTicks=\"false\" forever=\"false\" kind=\"Observer\" width=\"95\">setup</button>\n    <button x=\"105\" y=\"10\" height=\"40\" disableUntilTicks=\"false\" forever=\"true\" kind=\"Observer\" width=\"95\">go\n</button>\n    <plot x=\"5\" autoPlotX=\"true\" yMax=\"100\" autoPlotY=\"true\" y=\"120\" xMin=\"0\" height=\"235\" legend=\"false\" xMax=\"10\" yMin=\"0\" width=\"340\" display=\"Percentage of Population Sick\">\n      <setup/>\n      <update/>\n      <pen interval=\"1\" mode=\"0\" display=\"% Sick\" color=\"-16777216\" legend=\"true\">\n        <setup/>\n        <update>plot sick-percentage</update>\n      </pen>\n    </plot>\n    <monitor x=\"5\" precision=\"0\" y=\"55\" height=\"60\" fontSize=\"11\" width=\"135\" display=\"Number of People\">count turtles</monitor>\n  </widgets>\n  <info>## WHAT IS IT?\n\n(a general understanding of what the model is trying to show or explain)\n\n## HOW IT WORKS\n\n(what rules the agents use to create the overall behavior of the model)\n\n## HOW TO USE IT\n\n(how to use the model, including a description of each of the items in the Interface tab)\n\n## THINGS TO NOTICE\n\n(suggested things for the user to notice while running the model)\n\n## THINGS TO TRY\n\n(suggested things for the user to try to do (move sliders, switches, etc.) with the model)\n\n## EXTENDING THE MODEL\n\n(suggested things to add or change in the Code tab to make the model more complicated, detailed, accurate, etc.)\n\n## NETLOGO FEATURES\n\n(interesting or unusual features of NetLogo that the model uses, particularly in the Code tab; or where workarounds were needed for missing features)\n\n## RELATED MODELS\n\n(models in the NetLogo Models Library and elsewhere which are of related interest)\n\n## CREDITS AND REFERENCES\n\n(a reference to the model's URL on the web if it has one, as well as any other necessary credits, citations, and links)</info>\n  <turtleShapes>\n    <shape name=\"default\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"5\"/>\n        <point x=\"40\" y=\"250\"/>\n        <point x=\"150\" y=\"205\"/>\n        <point x=\"260\" y=\"250\"/>\n      </polygon>\n    </shape>\n    <shape name=\"airplane\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"0\"/>\n        <point x=\"135\" y=\"15\"/>\n        <point x=\"120\" y=\"60\"/>\n        <point x=\"120\" y=\"105\"/>\n        <point x=\"15\" y=\"165\"/>\n        <point x=\"15\" y=\"195\"/>\n        <point x=\"120\" y=\"180\"/>\n        <point x=\"135\" y=\"240\"/>\n        <point x=\"105\" y=\"270\"/>\n        <point x=\"120\" y=\"285\"/>\n        <point x=\"150\" y=\"270\"/>\n        <point x=\"180\" y=\"285\"/>\n        <point x=\"210\" y=\"270\"/>\n        <point x=\"165\" y=\"240\"/>\n        <point x=\"180\" y=\"180\"/>\n        <point x=\"285\" y=\"195\"/>\n        <point x=\"285\" y=\"165\"/>\n        <point x=\"180\" y=\"105\"/>\n        <point x=\"180\" y=\"60\"/>\n        <point x=\"165\" y=\"15\"/>\n      </polygon>\n    </shape>\n    <shape name=\"arrow\" rotatable=\"true\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"0\"/>\n        <point x=\"0\" y=\"150\"/>\n        <point x=\"105\" y=\"150\"/>\n        <point x=\"105\" y=\"293\"/>\n        <point x=\"195\" y=\"293\"/>\n        <point x=\"195\" y=\"150\"/>\n        <point x=\"300\" y=\"150\"/>\n      </polygon>\n    </shape>\n    <shape name=\"box\" rotatable=\"false\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"285\"/>\n        <point x=\"285\" y=\"225\"/>\n        <point x=\"285\" y=\"75\"/>\n        <point x=\"150\" y=\"135\"/>\n      </polygon>\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"150\" y=\"135\"/>\n        <point x=\"15\" y=\"75\"/>\n        <point x=\"150\" y=\"15\"/>\n        <point x=\"285\" y=\"75\"/>\n      </polygon>\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"15\" y=\"75\"/>\n        <point x=\"15\" y=\"225\"/>\n        <point x=\"150\" y=\"285\"/>\n        <point x=\"150\" y=\"135\"/>\n   