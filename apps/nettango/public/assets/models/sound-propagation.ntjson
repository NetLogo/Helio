89\" y=\"96\"/>\n        <point x=\"180\" y=\"89\"/>\n      </polygon>\n      <circle x=\"47\" y=\"195\" marked=\"true\" color=\"-1920102913\" diameter=\"58\" filled=\"true\"/>\n      <circle x=\"195\" y=\"195\" marked=\"true\" color=\"-1920102913\" diameter=\"58\" filled=\"true\"/>\n    </shape>\n    <shape name=\"circle 2\" rotatable=\"false\" editableColorIndex=\"0\">\n      <circle x=\"0\" y=\"0\" marked=\"true\" color=\"-1920102913\" diameter=\"300\" filled=\"true\"/>\n      <circle x=\"30\" y=\"30\" marked=\"false\" color=\"255\" diameter=\"240\" filled=\"true\"/>\n    </shape>\n    <shape name=\"cow\" rotatable=\"false\" editableColorIndex=\"0\">\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"200\" y=\"193\"/>\n        <point x=\"197\" y=\"249\"/>\n        <point x=\"179\" y=\"249\"/>\n        <point x=\"177\" y=\"196\"/>\n        <point x=\"166\" y=\"187\"/>\n        <point x=\"140\" y=\"189\"/>\n        <point x=\"93\" y=\"191\"/>\n        <point x=\"78\" y=\"179\"/>\n        <point x=\"72\" y=\"211\"/>\n        <point x=\"49\" y=\"209\"/>\n        <point x=\"48\" y=\"181\"/>\n        <point x=\"37\" y=\"149\"/>\n        <point x=\"25\" y=\"120\"/>\n        <point x=\"25\" y=\"89\"/>\n        <point x=\"45\" y=\"72\"/>\n        <point x=\"103\" y=\"84\"/>\n        <point x=\"179\" y=\"75\"/>\n        <point x=\"198\" y=\"76\"/>\n        <point x=\"252\" y=\"64\"/>\n        <point x=\"272\" y=\"81\"/>\n        <point x=\"293\" y=\"103\"/>\n        <point x=\"285\" y=\"121\"/>\n        <point x=\"255\" y=\"121\"/>\n        <point x=\"242\" y=\"118\"/>\n        <point x=\"224\" y=\"167\"/>\n      </polygon>\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n        <point x=\"73\" y=\"210\"/>\n        <point x=\"86\" y=\"251\"/>\n        <point x=\"62\" y=\"249\"/>\n        <point x=\"48\" y=\"208\"/>\n      </polygon>\n      <polygon color=\"-1920102913\" filled=\"true\" marked=\"true\">\n      