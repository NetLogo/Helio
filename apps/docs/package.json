{
  "name": "docs",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "create:env": "node -e \"const fs = require('fs'); if (fs.existsSync('.env.example')) { if (!fs.existsSync('.env')) { fs.copyFileSync('.env.example', '.env'); console.log('✓ .env created from .env.example'); } else { console.log('✓ .env already exists'); } } else { console.log('⚠ .env.example not found'); }\"",
    "init": "npm run create:env && nuxt prepare",
    "docs:build": "./scripts/generate.sh",
    "docs:deploy": "bash ./scripts/deploy.sh",
    "docs:preview": "bash ./scripts/preview.sh",
    "docs:clean-up": "bash ./scripts/clean-up.sh",
    "docs:build-and-generate-manual": "bash ./scripts/generate-manual/build-html.sh && yarn run docs:generate-manual",
    "docs:generate-manual": "bash ./scripts/generate-manual/run.sh",
    "docs:build:offline": "bash ./scripts/build-offline-site.sh",
    "docs:all": "npm run docs:clean-up && npm run docs:build && npm run docs:generate-manual && npm run docs:deploy",
    "docs:dev": "yarn run nuxt:dev:no-autogen",
    "nuxt:build": "nuxt build",
    "nuxt:dev": "nuxt dev --port 3001",
    "nuxt:dev:no-autogen": "sh -c 'NO_AUTOGEN=true nuxt dev --port 3001'",
    "nuxt:dev:watch": "nuxt dev --port 3001 --dotenv .env.development",
    "nuxt:dev:no-autogen:watch": "sh -c 'NO_AUTOGEN=true nuxt dev --port 3001 --dotenv .env.development'",
    "nuxt:generate": "sh -c 'NODE_OPTIONS=\"--max-old-space-size=6144\" nuxt prepare && nuxt generate'",
    "nuxt:preview": "nuxt preview",
    "nuxt:postinstall": "nuxt prepare",
    "nuxt:prepare": "nuxt prepare",
    "check-types": "nuxi typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "node-version": "node -v && npm -v",
    "turbo:postinstall": "nuxt prepare",
    "test:e2e": "vitest run --project e2e",
    "test:artifacts": "vitest run --project artifacts"
  },
  "dependencies": {
    "@nuxt/content": "^3.16.2",
    "@nuxt/eslint": "1.10.0",
    "@nuxt/icon": "2.5.1",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/sitemap": "9.1.0",
    "@repo/eslint-config": "0.0.0",
    "@repo/netlogo-docs": "0.0.0",
    "@repo/nuxt-core": "0.0.0",
    "@repo/tailwind-config": "0.0.0",
    "@repo/template": "0.0.0",
    "@repo/typescript-config": "0.0.0",
    "@repo/utils": "0.0.0",
    "@repo/vue-ui": "1.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.4.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.31.0",
    "minimatch": "^10.0.3",
    "nuxt": "4.6.2",
    "nuxt-gtag": "5.0.0",
    "nuxt-link-checker": "6.0.1",
    "nuxt-og-image": "^7.0.7",
    "nuxt-svgo": "5.3.0",
    "reka-ui": "2.11.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "3.5.44",
    "vue-router": "^5.4.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@iconify-json/bi": "^1.2.6",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/logos": "^1.2.9",
    "@iconify-json/lucide": "^1.2.68",
    "@iconify-json/material-icon-theme": "^1.2.34",
    "@iconify-json/material-symbols": "^1.2.40",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/mingcute": "^1.2.5",
    "@iconify-json/oui": "^1.2.6",
    "@iconify-json/si": "^1.2.11",
    "@iconify-json/simple-icons": "^1.2.54",
    "@iconify-json/streamline": "^1.2.5",
    "@nuxt/kit": "4.6.2",
    "@repo/markdown": "0.0.0",
    "@repo/nuxt-content-assets": "1.5.0",
    "@types/html-minifier-terser": "^7.0.2",
    "eslint-plugin-perfectionist": "^4.15.1",
    "extend": "^3.0.2",
    "fs-extra": "^11.3.0",
    "fuse.js": "^7.1.0",
    "html-minifier-terser": "^7.2.0",
    "mupdf": "^1.27.0",
    "puppeteer": "^24.28.0",
    "rehype-autolink-headings": "^7.1.0",
    "remark-toc": "^9.0.0",
    "sass": "^1.93.3",
    "sharp": "^0.34.4",
    "turbo-meta-utilities": "^1.0.1",
    "typescript": "^5.4.0",
    "zod": "^4.1.12",
    "@nuxt/test-utils": "^4.3.4",
    "@repo/vitest-config": "0.0.0",
    "playwright-core": "^1.60.0",
    "vitest": "^4.0.16"
  }
}
