generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums

enum ModelVisibility {
  public
  private
  unlisted
}

enum SystemRole {
  admin
  moderator
  user
}

enum UserKind {
  student
  teacher
  researcher
  other
}

enum AuthorRole {
  owner
  contributor
}

enum PermissionLevel {
  read
  write
  admin
}

enum ModelInteractionKind {
  view
  run
  download
  share
}

enum ModelFileKind {
  model
  additional
}

// Better Auth core tables

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @db.Timestamptz(3) @default(now())
  updatedAt     DateTime  @db.Timestamptz(3) @updatedAt

  // Extended fields
  systemRole    SystemRole @default(user)
  userKind      UserKind   @default(other)
  isProfilePublic Boolean  @default(false)
  deletedAt     DateTime?

  // User profile fields
  bio           String?
  country       String?
  socialLinks   Json? // e.g. [{ platform: 'twitter', url: '...' }]
  dob           DateTime? @db.Date
  affiliation   String?

  // Better Auth relations
  accounts      Account[]
  sessions      Session[]
  verifications Verification[]

  // Domain relations
  authoredModels   ModelAuthor[]
  grantedPermissions ModelPermission[]
  events           Event[]
  modelLikes       ModelLike[]
  modelInteractions ModelInteraction[]
  modelDrafts      ModelDraft[]

  // Better Auth Admin plugin
  role String?
  banned Boolean?
  banReason String?
	banExpires DateTime? @db.Timestamptz(3)

  // Application behavior
  onboardedAt DateTime? @db.Timestamptz(3)
  legacyId Int? @unique

  // Passkey relations
  passkeys Passkey[]
}

model Account {
  id                     String   @id @default(uuid())
  userId                 String
  accountId              String
  providerId             String
  accessToken            String?
  refreshToken           String?
  accessTokenExpiresAt   DateTime? @db.Timestamptz(3)
	refreshTokenExpiresAt  DateTime? @db.Timestamptz(3)
  scope                  String?
  idToken                String?
	password               String?
	createdAt              DateTime  @db.Timestamptz(3) @default(now())
	updatedAt              DateTime  @db.Timestamptz(3) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Better Auth Admin plugin fields
  impersonatedBy String?

  @@index([userId])
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @db.Timestamptz(3) @default(now())
  updatedAt  DateTime? @db.Timestamptz(3) @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  @@index([userId])
}

model Passkey {
  id            String @id @default(uuid())
	name          String?
	publicKey     String
	userId        String
	credentialID  String
	counter       Int
	deviceType    String
	backedUp      Boolean
	transports    String?
	createdAt     DateTime? @db.Timestamptz(3) @default(now())
	aaguid        String?

	user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Domain models

model Model {
  id                  String          @id @default(uuid())
  legacyId            Int?            @unique
  latestVersionNumber Int?
  parentModelId       String?
  parentVersionNumber Int?
  visibility          ModelVisibility @default(public)
  isEndorsed          Boolean         @default(false)
  isLibraryModel      Boolean         @default(false)
  viewCount           Int             @default(0)
  runCount            Int             @default(0)
  downloadCount       Int             @default(0)
  shareCount          Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?

  latestVersion   ModelVersion?  @relation("LatestVersion", fields: [id, latestVersionNumber], references: [modelId, versionNumber])
  parentModel     Model?         @relation("ModelParent", fields: [parentModelId], references: [id])
  childModels     Model[]        @relation("ModelParent")
  parentVersion   ModelVersion?  @relation("ParentVersion", fields: [parentModelId, parentVersionNumber], references: [modelId, versionNumber])

  versions        ModelVersion[]  @relation("ModelVersions")
  authors         ModelAuthor[]
  nonMemberContributors NonMemberContributor[]
  permissions     ModelPermission[]
  additionalFiles ModelAdditionalFile[]
  likes           ModelLike[]
  interactions    ModelInteraction[]
  drafts          ModelDraft[]


  @@unique([id, latestVersionNumber])
  @@index([parentModelId])
  @@index([parentModelId, parentVersionNumber])
  @@index([viewCount])
  @@index([runCount])
  @@index([downloadCount])
}

model ModelVersion {
  modelId          String
  versionNumber    Int
  title            String
  description      String?
  changeSummary    String?
  previewImageFileKey String?
  netlogoFileKey      String
  netlogoVersion   String?
  infoTab          String?
  createdAt        DateTime  @default(now())
  finalizedAt      DateTime?

  model       Model  @relation("ModelVersions", fields: [modelId], references: [id], onDelete: Cascade)

  // Reverse relations
  latestOfModel  Model?  @relation("LatestVersion")
  parentOfModels Model[] @relation("ParentVersion")

  tags  ModelVersionTag[]
  taggedAdditionalFiles ModelAdditionalFile[]

  @@id([modelId, versionNumber])
  @@index([modelId])
}

model ModelVersionTag {
  modelId       String
  versionNumber Int
  tagId         String
  createdAt     DateTime @default(now())

  modelVersion ModelVersion @relation(fields: [modelId, versionNumber], references: [modelId, versionNumber], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([modelId, versionNumber, tagId])
  @@index([tagId])
}

model ModelAdditionalFile {
  id                  String   @id @default(uuid())
  modelId             String
  taggedVersionNumber Int
  fileKey             String
  kind                ModelFileKind @default(additional)
  createdAt           DateTime @default(now())

  model         Model        @relation(fields: [modelId], references: [id], onDelete: Cascade)
  taggedVersion ModelVersion @relation(fields: [modelId, taggedVersionNumber], references: [modelId, versionNumber])

  @@index([modelId])
  @@index([modelId, taggedVersionNumber])
}

model Tag {
  id          String   @id @default(uuid())
  legacyId    Int?     @unique
  name        String   @unique
  displayName String?
  createdAt   DateTime @default(now())

  modelVersions ModelVersionTag[]
}

model ModelAuthor {
  modelId   String
  userId    String
  role      AuthorRole
  // Legacy collaborator_types.name, kept for provenance. Nothing reads it.
  collaboratorType String?
  createdAt DateTime @default(now())

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id ([modelId, userId])
  @@index([userId])
}

// Legacy non_member_collaborators joined onto non_member_collaborations: people
// credited on a model who never held an account. Archival only, no business logic
// reads this table.
model NonMemberContributor {
  id               String   @id @default(uuid())
  legacyId         Int      @unique
  modelId          String
  email            String?
  name             String?
  collaboratorType String?
  addedByUserId    String?
  createdAt        DateTime @default(now())

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
  @@index([email])
}

model ModelPermission {
  id              String          @id @default(uuid())
  modelId         String
  granteeUserId   String?
  permissionLevel PermissionLevel
  createdAt       DateTime        @default(now())

  model       Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
  granteeUser User?  @relation(fields: [granteeUserId], references: [id], onDelete: Cascade)

  @@unique([modelId, granteeUserId])
  @@index([modelId])
  @@index([granteeUserId])
}

model ModelLike {
  modelId   String
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([modelId, userId])
  @@index([userId])
  @@index([modelId, createdAt])
}

model ModelInteraction {
  id            String               @id @default(uuid())
  modelId       String
  versionNumber Int?
  kind          ModelInteractionKind
  userId        String?
  sessionId     String?
  ipHash        String?
  userAgent     String?
  referer       String?
  geo           Json?
  cookie        String?

  createdAt     DateTime             @default(now()) @db.Timestamptz(3)

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([modelId, kind, createdAt])
  @@index([modelId, kind, userId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model ModelDraft {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  modelId       String?
  model         Model?   @relation(fields: [modelId], references: [id], onDelete: Cascade)

  schemaVersion Int
  data          Json

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([modelId])
}

model Event {
  id           String    @id @default(uuid())
  type         String
  actorId      String
  resourceType String
  resourceId   String
  payload      Json
  createdAt    DateTime  @default(now())
  processedAt  DateTime?

  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([type])
  @@index([processedAt])
}
