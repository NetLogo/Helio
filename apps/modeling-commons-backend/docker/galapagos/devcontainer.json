{
  "name": "Galapagos integration devcontainer",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "containerEnv": {
    "GALAPAGOS_DIR": "/opt/galapagos",
    "NVM_DIR": "/usr/local/share/nvm"
  },
  "mounts": [
    "source=galapagos-ivy2,target=/home/vscode/.ivy2,type=volume",
    "source=galapagos-sbt,target=/home/vscode/.sbt,type=volume",
    "source=galapagos-coursier,target=/home/vscode/.cache/coursier,type=volume",
    "source=galapagos-npm,target=/home/vscode/.npm,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/sync-galapagos.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "metals.javaHome": "/usr/lib/jvm/bellsoft-java25-amd64"
      },
      "extensions": [
        "scala-lang.scala",
        "scalameta.metals",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
