generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums

enum ModelVisibility {
  public
  private
  unlisted
}

enum SystemRole {
  admin
  moderator
  user
}

enum UserKind {
  student
  teacher
  researcher
  other
}

enum AuthorRole {
  owner
  contributor
}

enum PermissionLevel {
  read
  write
  admin
}

enum ModelInteractionKind {
  view
  run
  download
  share
}

// Better Auth core tables

model User {
  id            String   @id @default(uuid())
  name          String?
  email         String?  @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  // Extended fields
  systemRole      SystemRole @default(user)
  userKind        UserKind   @default(other)
  isProfilePublic Boolean    @default(false)
  deletedAt       DateTime?

  // Better Auth relations
  accounts      Account[]
  sessions      Session[]
  verifications Verification[]

  // Domain relations
  authoredModels     ModelAuthor[]
  grantedPermissions ModelPermission[]
  events             Event[]
  modelLikes         ModelLike[]
  modelInteractions  ModelInteraction[]

  // Better Auth Admin plugin
  role       String?
  banned     Boolean?
  banReason  String?
  banExpires DateTime? @db.Timestamptz(3)

  // Passkey relations
  passkeys Passkey[]
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Better Auth Admin plugin fields
  impersonatedBy String?

  @@index([userId])
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime? @updatedAt @db.Timestamptz(3)

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  @@index([userId])
}

model Passkey {
  id           String    @id @default(uuid())
  name         String?
  publicKey    String
  userId       String
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now()) @db.Timestamptz(3)
  aaguid       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Domain models

model Model {
  id                  String          @id @default(uuid())
  latestVersionNumber Int?
  parentModelId       String?
  parentVersionNumber Int?
  visibility          ModelVisibility @default(public)
  isEndorsed          Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?

  latestVersion ModelVersion? @relation("LatestVersion", fields: [id, latestVersionNumber], references: [modelId, versionNumber])
  parentModel   Model?        @relation("ModelParent", fields: [parentModelId], references: [id])
  childModels   Model[]       @relation("ModelParent")
  parentVersion ModelVersion? @relation("ParentVersion", fields: [parentModelId, parentVersionNumber], references: [modelId, versionNumber])

  versions        ModelVersion[]        @relation("ModelVersions")
  authors         ModelAuthor[]
  permissions     ModelPermission[]
  additionalFiles ModelAdditionalFile[]
  likes           ModelLike[]
  interactions    ModelInteraction[]

  @@unique([id, latestVersionNumber])
  @@index([parentModelId])
  @@index([parentModelId, parentVersionNumber])
}

model ModelVersion {
  modelId        String
  versionNumber  Int
  title          String
  description    String?
  previewImage   Bytes?
  netlogoFileKey String
  netlogoVersion String?
  infoTab        String?
  createdAt      DateTime  @default(now())
  finalizedAt    DateTime?

  isDraft Boolean @default(false)

  model Model @relation("ModelVersions", fields: [modelId], references: [id], onDelete: Cascade)

  // Reverse relations
  latestOfModel  Model?  @relation("LatestVersion")
  parentOfModels Model[] @relation("ParentVersion")

  files                 ModelVersionFile[]
  tags                  ModelVersionTag[]
  taggedAdditionalFiles ModelAdditionalFile[]

  @@id([modelId, versionNumber])
  @@index([modelId])
}

model ModelVersionFile {
  id            String @id @default(uuid())
  modelId       String
  versionNumber Int
  fileKey       String

  modelVersion ModelVersion @relation(fields: [modelId, versionNumber], references: [modelId, versionNumber], onDelete: Cascade)

  @@index([modelId, versionNumber])
  @@index([fileKey])
}

model ModelVersionTag {
  modelId       String
  versionNumber Int
  tagId         String
  createdAt     DateTime @default(now())

  modelVersion ModelVersion @relation(fields: [modelId, versionNumber], references: [modelId, versionNumber], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([modelId, versionNumber, tagId])
  @@index([tagId])
}

model ModelAdditionalFile {
  id                  String   @id @default(uuid())
  modelId             String
  taggedVersionNumber Int
  fileKey             String
  createdAt           DateTime @default(now())

  model         Model        @relation(fields: [modelId], references: [id], onDelete: Cascade)
  taggedVersion ModelVersion @relation(fields: [modelId, taggedVersionNumber], references: [modelId, versionNumber])

  @@index([modelId])
  @@index([modelId, taggedVersionNumber])
}

model Tag {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String?
  createdAt   DateTime @default(now())

  modelVersions ModelVersionTag[]
}

model ModelAuthor {
  modelId   String
  userId    String
  role      AuthorRole
  createdAt DateTime   @default(now())

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([modelId, userId])
  @@index([userId])
}

model ModelPermission {
  id              String          @id @default(uuid())
  modelId         String
  granteeUserId   String?
  permissionLevel PermissionLevel
  createdAt       DateTime        @default(now())

  model       Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
  granteeUser User? @relation(fields: [granteeUserId], references: [id], onDelete: Cascade)

  @@unique([modelId, granteeUserId])
  @@index([modelId])
  @@index([granteeUserId])
}

model ModelLike {
  modelId   String
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([modelId, userId])
  @@index([userId])
  @@index([modelId, createdAt])
}

model ModelInteraction {
  id            String               @id @default(uuid())
  modelId       String
  versionNumber Int?
  kind          ModelInteractionKind
  userId        String?
  sessionId     String?
  ipHash        String?
  userAgent     String?
  referer       String?
  geo           Json?
  cookie        String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([modelId, kind, createdAt])
  @@index([modelId, kind, userId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model Event {
  id           String    @id @default(uuid())
  type         String
  actorId      String
  resourceType String
  resourceId   String
  payload      Json
  createdAt    DateTime  @default(now())
  processedAt  DateTime?

  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([type])
  @@index([processedAt])
}
