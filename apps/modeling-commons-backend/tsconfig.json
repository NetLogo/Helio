{
  "extends": "@repo/typescript-config/fastify",
  "compilerOptions": {
    "paths": {
      "#src/*": ["./src/*"],
      "#modules/*": ["./src/modules/*"],
      "#tests/*": ["./tests/*"],
      "#prisma/*": ["./generated/prisma/*"]
    }
  },
  "include": ["src", "tests", "prisma/lib", "prisma/archive.ts", "prisma/patch.ts"],
  "exclude": ["**/*.k6.ts"]
}
